    r.onload=()=>{
      try{
        const d=JSON.parse(r.result);let nc=[],ng=[],nn=[];
        if(Array.isArray(d)){nc=d.map(i=>({id:uid(),username:String(i.username||''),password:String(i.password||''),createdAt:i.createdAt||new Date().toISOString(),updatedAt:i.updatedAt||new Date().toISOString()}));}
        else if(d&&typeof d==='object'){
          if(Array.isArray(d.credentials))nc=d.credentials.map(i=>({id:uid(),username:String(i.username||''),password:String(i.password||''),createdAt:i.createdAt||new Date().toISOString(),updatedAt:i.updatedAt||new Date().toISOString()}));
          if(Array.isArray(d.serverGroups))ng=d.serverGroups.map(g=>sanitizeGroup(g));
          if(Array.isArray(d.notes))nn=d.notes.map(sanitizeNote);
          if(d.notesViewMode==='free'||d.notesViewMode==='grid'||d.notesViewMode==='single')notesViewMode=d.notesViewMode;
        } else throw new Error('Unrecognized file format');
        const have=entries.length||groups.length||notes.length;
        if(have){const m='This will REPLACE all current data.\n\nFile contains:\n• '+nc.length+' credential(s)\n• '+ng.length+' server group(s)\n• '+nn.length+' note(s)\n\nContinue?';if(!confirm(m)){importFile.value='';return;}}
        for(const oldId of noteFileHandles.keys())idbDeleteHandle(oldId);
        noteFileHandles.clear();
        autoSaveTimers.forEach(t=>clearTimeout(t));autoSaveTimers.clear();
        entries=nc;groups=ng;notes=nn;
        manualSortMode=nn.some(n=>typeof n.order==='number');
        if(manualSortMode)resetSortBtn.classList.remove('hidden');else resetSortBtn.classList.add('hidden');
        visiblePasswords.clear();activeTags.clear();dirtyNotes.clear();
        saveCreds();saveGroups();saveNotes();saveNotesViewMode();
        editingId=null;editingServer=null;editingGroupId=null;editingExtraId=null;addingToGroupId=null;
        renderCredentials();renderServers();renderNotes();updateStats();checkPasswordBanner();
        showToast('Imported '+nc.length+' cred, '+ng.length+' group(s), '+nn.length+' note(s)');
      }catch(e){alert('Could not read file: '+e.message);}
      importFile.value='';
    };
    r.readAsText(f);
  });

  credSearchEl.addEventListener('input',e=>{e.stopPropagation();credQuery=credSearchEl.value;renderCredentials();});
  credSearchEl.addEventListener('click',e=>e.stopPropagation());
  srvSearchEl.addEventListener('input',e=>{e.stopPropagation();srvQuery=srvSearchEl.value;renderServers();});
  srvSearchEl.addEventListener('click',e=>e.stopPropagation());

  document.addEventListener('keydown',e=>{
    if(isLocked)return;
    if(e.key==='Escape'){
      if(!mapPop.classList.contains('hidden')){closeMapPop();return;}
      credSortMenu.classList.add('hidden');srvSortMenu.classList.add('hidden');
      if(notesViewMenu && !notesViewMenu.classList.contains('hidden')){notesViewMenu.classList.add('hidden');notesViewToggle.classList.toggle('active',notesViewMode!=='grid');}
      closeQuickMenu();closeColorPicker();closeMenu();
      if(!addPanelCred.classList.contains('hidden'))closePanel('cred');
      if(!addPanelGroup.classList.contains('hidden'))closePanel('group');
      if(!tagFilterDropdown.classList.contains('hidden')){tagFilterDropdown.classList.add('hidden');tagFilterBtn.classList.toggle('active',activeTags.size>0);}
    }
    const tag=(e.target.tagName||'').toLowerCase();const inF=tag==='input'||tag==='textarea'||e.target.isContentEditable;
    if(inF||e.ctrlKey||e.metaKey||e.altKey)return;
    if(e.key==='n'){e.preventDefault();if(addPanelCred.classList.contains('hidden'))toggleAddCred.click();addForm.username.focus();}
    else if(e.key==='g'){e.preventDefault();if(addPanelGroup.classList.contains('hidden'))toggleAddGroup.click();newGroupName.focus();}
  });
  window.addEventListener('beforeunload',e=>{
    if(dirtyNotes.size>0){
      notes.forEach(n=>{if(dirtyNotes.has(n.id))n.updatedAt=new Date().toISOString();});
      if(!cryptoKey){
        try{localStorage.setItem(NOTES_KEY,JSON.stringify(notes));}catch(_){}
      }
      e.preventDefault();e.returnValue='';return'';
    }
  });

  window.addEventListener('resize', () => {
    clearTimeout(resizeDebounceTimer);
    resizeDebounceTimer = setTimeout(() => {
      const effective = notesViewMode === 'free' && !isMobile();
      if (effective !== lastEffectiveFreeMode) renderNotes();
      else if (effective) expandCanvasHeight();
      else updateNotesViewToggle();
    }, 180);
  });

  function updateDate(){const n=new Date();const d=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];const m=['January','February','March','April','May','June','July','August','September','October','November','December'];const s=d[n.getDay()]+', '+String(n.getDate()).padStart(2,'0')+' '+m[n.getMonth()]+' '+n.getFullYear();const el=$('liveDate');if(el)el.textContent=s;}

  async function startApp(){
    try{const s=localStorage.getItem(THEME_KEY);applyTheme(s||'dark');}catch(e){applyTheme('dark');}
    updateSortButton();updateCredSortButton();updateDate();
    applyCardCollapse();updateSecurityUI();resetIdleTimer();updateAutoSaveUI();
    renderCredentials();renderServers();renderNotes();updateStats();
    checkBackupReminder();checkPasswordBanner();
    if(FSA_SUPPORTED){try{await restoreHandlesFromIdb();renderNotes();}catch(e){}}
    requestAnimationFrame(()=>{document.body.classList.add('app-ready');document.body.classList.remove('password-locked');});
  }

  (async function boot(){
    loadMeta();
    if(!WEB_CRYPTO_OK){
      cryptoKey=null;
      try{ await loadData(); }catch(e){}
      appStarted=true;
      await startApp();
      return;
    }
    if(hasMasterPassword()){
      isLocked=true;
      cryptoKey=null;
      document.body.classList.add('password-locked');
      showSecurityModal('unlock',{forceLock:false});
      return;
    }
    cryptoKey=null;
    try{ await loadData(); }catch(e){}
    appStarted=true;
    await startApp();
  })();
})();
</script>
</body>
</html>

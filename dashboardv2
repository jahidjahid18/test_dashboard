  .note-body{flex:1;min-height:80px;max-height:300px;width:100%;background:transparent;border:none;outline:none;padding:10px 12px;font-family:inherit;color:var(--txt);overflow-y:auto;overflow-x:hidden;word-wrap:break-word;white-space:pre-wrap}

    const contentLeft=gr.left+padL;
    const contentRight=gr.right-padR;
    const contentTop=gr.top+10;
    const snapLeft=Math.round(r.left);
    const snapTop=Math.round(r.top);
    const snapW=Math.round(r.width);
    const snapH=Math.round(r.height);
    resizeState={noteEl,id:n.id,dir,startX:e.clientX,startY:e.clientY,startLeft:snapLeft,startTop:snapTop,startW:snapW,startH:snapH,minW:240,minH:140,maxW:1400,maxH:1200,contentLeft,contentRight,contentTop};

  function sanitizeNoteHtml(html){
    const allowed=new Set(['B','STRONG','I','EM','U','S','STRIKE','DEL','BR','DIV','P','SPAN','UL','OL','LI','CODE','PRE','FONT']);
    const okStyles=new Set(['color','background-color','font-weight','font-style','text-decoration','font-family','font-size']);
    const root=document.createElement('div');
    root.innerHTML=String(html||'');
    const clean=el=>{
      [...el.children].forEach(child=>{
        if(child.tagName==='SCRIPT'||child.tagName==='STYLE'||child.tagName==='IFRAME'||child.tagName==='OBJECT'||child.tagName==='EMBED'){child.remove();return;}
        clean(child);
        if(!allowed.has(child.tagName)){
          while(child.firstChild)child.parentNode.insertBefore(child.firstChild,child);
          child.remove();
          return;
        }
        [...child.attributes].forEach(a=>{
          if(a.name==='style'){
            const keep=[];
            child.style.cssText.split(';').forEach(decl=>{
              const p=decl.split(':')[0];
              if(p&&okStyles.has(p.trim().toLowerCase()))keep.push(decl.trim());
            });
            if(keep.length)child.setAttribute('style',keep.join('; '));
            else child.removeAttribute('style');
          } else if(a.name==='color'&&child.tagName==='FONT'){
            /* allow */
          } else {
            child.removeAttribute(a.name);
          }
        });
      });
    };
    clean(root);
    return root.innerHTML;
  }

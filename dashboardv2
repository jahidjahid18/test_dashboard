  .note[data-color="aurora"]{background:radial-gradient(circle at 15% 100%,rgba(61,220,132,.32),transparent 55%),radial-gradient(circle at 85% 0%,rgba(180,100,255,.30),transparent 55%),radial-gradient(circle at 50% 50%,rgba(91,149,255,.14),transparent 70%),linear-gradient(180deg,rgba(40,30,80,.35),rgba(20,25,55,.18))}
  .note[data-color="aurora"] .note-body,.note[data-color="aurora"] .note-title{color:#f0e8ff}
  .note[data-color="mint"]{background:linear-gradient(180deg,rgba(80,220,190,.20),rgba(80,220,190,.06) 60%,transparent)}

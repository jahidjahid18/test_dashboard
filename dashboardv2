<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Dashboard</title>
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; font-src data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'">
<style>
  .hidden{display:none!important}
  :root{--bg:#0b1018;--panel:#141b28;--panel-2:#1a2333;--row:#161e2c;--row-alt:#131a27;--row-hover:#1d2739;--line:#2e3d57;--line-soft:#26334b;--txt:#f0f4fc;--muted:#a3b0c7;--accent:#5b95ff;--accent-2:#82b3ff;--ok:#3ddc84;--bad:#ff6b6b;--warn:#ffcc00;--grad-1:#1c2740;--grad-2:#171f31;--radius:14px}
  html[data-theme="light"]{--bg:#f5f7fb;--panel:#ffffff;--panel-2:#eef2f9;--row:#ffffff;--row-alt:#f8fafd;--row-hover:#e8effc;--line:#d3dced;--line-soft:#e2e8f3;--txt:#1a2333;--muted:#5e6b85;--accent:#3d7bf0;--accent-2:#2f6be0;--ok:#1eab5f;--bad:#e04343;--warn:#a67c00;--grad-1:#e8eefb;--grad-2:#eef2f9}
  html[data-theme="midnight"]{--bg:#06070d;--panel:#0d0f18;--panel-2:#131622;--row:#0e1019;--row-alt:#0a0c14;--row-hover:#161a28;--line:#2a2f45;--line-soft:#1f2336;--txt:#f0f4fc;--muted:#8f9bb5;--accent:#7c5cff;--accent-2:#a48cff;--ok:#3ddc84;--bad:#ff5c7c;--warn:#ffcc00;--grad-1:#141a2e;--grad-2:#0e1322}
  html[data-theme="nord"]{--bg:#2e3440;--panel:#3b4252;--panel-2:#434c5e;--row:#3b4252;--row-alt:#353b48;--row-hover:#434c5e;--line:#4c566a;--line-soft:#434c5e;--txt:#eceff4;--muted:#a4afc1;--accent:#88c0d0;--accent-2:#8fbcbb;--ok:#a3be8c;--bad:#bf616a;--warn:#ebcb8b;--grad-1:#3b4252;--grad-2:#2e3440}
  html[data-theme="dracula"]{--bg:#1e1f29;--panel:#282a36;--panel-2:#343746;--row:#282a36;--row-alt:#232530;--row-hover:#343746;--line:#44475a;--line-soft:#3a3d4e;--txt:#f8f8f2;--muted:#a7aac2;--accent:#bd93f9;--accent-2:#ff79c6;--ok:#50fa7b;--bad:#ff5555;--warn:#f1fa8c;--grad-1:#383a59;--grad-2:#21222c}
  html[data-theme="solarized"]{--bg:#fdf6e3;--panel:#fffbf0;--panel-2:#f0e9d4;--row:#fffbf0;--row-alt:#faf3df;--row-hover:#f0e9d4;--line:#d9d0b6;--line-soft:#e6ddc4;--txt:#073642;--muted:#586e75;--accent:#268bd2;--accent-2:#1f6fa8;--ok:#859900;--bad:#dc322f;--warn:#b58900;--grad-1:#f0e9d4;--grad-2:#fdf6e3}
  html[data-theme="contrast"]{--bg:#000000;--panel:#0a0a0a;--panel-2:#161616;--row:#0a0a0a;--row-alt:#050505;--row-hover:#1c1c1c;--line:#5a5a5a;--line-soft:#333333;--txt:#ffffff;--muted:#c8c8c8;--accent:#ffcc00;--accent-2:#ffe066;--ok:#00e676;--bad:#ff1744;--warn:#ffcc00;--grad-1:#1a1a1a;--grad-2:#000000}
  *{box-sizing:border-box}
  html,body{height:100%}
  body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;background:radial-gradient(1100px 560px at 15% -10%,var(--grad-1) 0%,transparent 55%),radial-gradient(900px 500px at 100% 0%,var(--grad-2) 0%,transparent 50%),var(--bg);color:var(--txt);min-height:100vh;padding:28px 16px 40px;-webkit-font-smoothing:antialiased;font-size:15px;transition:background .2s,color .2s}
  body.dragging-active{cursor:grabbing;user-select:none}
  body.resizing-note{cursor:nwse-resize!important;user-select:none}
  body.resizing-note *{cursor:inherit!important}
  body.locked{overflow:hidden}
  body.password-locked .wrap{display:none!important}
  .wrap{max-width:1060px;margin:0 auto}
  .site-header{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:28px}
  .site-header-left{flex:1;min-width:0}
  .site-header h1{margin:0 0 6px;font-size:27px;letter-spacing:.2px;font-weight:800;display:flex;align-items:center;gap:11px;color:var(--txt);flex-wrap:wrap}
  .site-header h1 .dot{width:11px;height:11px;border-radius:50%;background:var(--ok);box-shadow:0 0 0 4px rgba(61,220,132,.18);flex:none}
  .site-header p{margin:0 0 4px;color:var(--muted);font-size:14.5px;line-height:1.5}
  #liveDate{color:var(--accent-2);font-weight:700}
  #statsLine{color:var(--muted);font-weight:600}
  #statsLine b{color:var(--accent-2);font-weight:800}
  .menu-wrap{position:relative;flex:none;margin-top:2px}
  .menu-btn{display:inline-flex;align-items:center;gap:9px;height:42px;padding:0 18px 0 15px;border-radius:22px;border:1px solid var(--line);background:var(--panel);color:var(--txt);font-family:inherit;font-size:14px;font-weight:800;letter-spacing:.4px;cursor:pointer;transition:.15s}
  .menu-btn svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;transition:transform .2s}
  .menu-btn:hover{border-color:var(--accent);color:var(--accent-2);background:var(--panel-2)}
  .menu-btn.open{border-color:var(--accent);color:var(--accent-2);background:var(--panel-2);box-shadow:0 0 0 3px rgba(91,149,255,.18)}
  .menu-btn.open svg{transform:rotate(90deg)}
  .menu-panel{position:absolute;top:calc(100% + 10px);right:0;min-width:280px;max-width:340px;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:8px;box-shadow:0 24px 60px -20px rgba(0,0,0,.9);z-index:120;animation:dropDown .18s ease-out}
  .menu-view{display:block}
  .menu-item,.menu-back{display:flex;align-items:center;gap:11px;width:100%;padding:11px 12px;border-radius:9px;border:none;background:transparent;color:var(--txt);font-family:inherit;font-size:14px;font-weight:600;cursor:pointer;text-align:left;transition:.13s}
  .menu-item:hover,.menu-back:hover{background:var(--panel-2);color:var(--accent-2)}
  .menu-item svg,.menu-back svg{width:16px;height:16px;flex:none;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  .menu-item .name{flex:1}
  .menu-item .menu-arrow{width:14px;height:14px;flex:none;stroke:var(--muted);fill:none;stroke-width:2.4}
  .menu-item:hover .menu-arrow{stroke:var(--accent-2)}
  .menu-item.danger:hover{color:var(--bad);background:rgba(255,107,107,.1)}
  .menu-item .badge{font-size:10px;font-weight:800;letter-spacing:.5px;padding:2px 7px;border-radius:10px;text-transform:uppercase}
  .menu-item .badge.on{background:rgba(61,220,132,.16);color:var(--ok);border:1px solid rgba(61,220,132,.45)}
  .menu-item .badge.off{background:rgba(128,128,128,.14);color:var(--muted);border:1px solid var(--line)}
  .menu-item svg.check{width:14px;height:14px;stroke:var(--accent-2);opacity:0;transition:opacity .15s;flex:none}
  .menu-item.active svg.check{opacity:1}
  .menu-item.active{color:var(--accent-2)}
  .menu-back{font-size:12px;color:var(--muted);font-weight:800;letter-spacing:.6px;text-transform:uppercase;padding:8px 12px}
  .menu-back:hover{color:var(--accent-2)}
  .menu-back svg{width:14px;height:14px;stroke-width:2.6}
  .menu-sep{height:1px;background:var(--line-soft);margin:6px 4px}
  .menu-label{padding:9px 12px 4px;font-size:11px;font-weight:800;letter-spacing:1px;text-transform:uppercase;color:var(--muted)}
  .menu-about{padding:8px 14px 14px;font-size:13.5px;line-height:1.6;color:var(--muted);font-weight:500}
  .menu-about p{margin:0 0 10px}
  .menu-about p:last-child{margin-bottom:0}
  .menu-about b{color:var(--warn);font-weight:800;display:block;margin-bottom:6px;font-size:13px;letter-spacing:.3px}
  .theme-opt{display:flex;align-items:center;gap:11px;width:100%;padding:10px 12px;font-family:inherit;font-size:14px;font-weight:600;background:transparent;border:none;color:var(--txt);border-radius:9px;cursor:pointer;text-align:left;transition:.15s}
  .theme-opt:hover{background:var(--panel-2)}
  .theme-opt.active{background:rgba(91,149,255,.14);color:var(--accent-2)}
  .theme-opt .swatch{flex:none;width:22px;height:22px;border-radius:6px;border:1px solid rgba(128,128,128,.3);overflow:hidden}
  .theme-opt .name{flex:1}
  .theme-opt .check{margin-left:auto;color:var(--accent-2);opacity:0;transition:.15s;width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2.6}
  .theme-opt.active .check{opacity:1}
  @keyframes dropDown{from{opacity:0;transform:translateY(-5px)}to{opacity:1;transform:none}}

  .sort-wrap{position:relative;display:inline-block}
  .sort-menu{position:absolute;top:calc(100% + 8px);right:0;min-width:220px;background:var(--panel);border:1px solid var(--line);border-radius:11px;box-shadow:0 24px 60px -22px rgba(0,0,0,.8);padding:6px;z-index:80;animation:dropDown .16s ease-out}
  .sort-opt{display:flex;align-items:center;gap:11px;width:100%;padding:10px 12px;font-family:inherit;font-size:14px;font-weight:600;background:transparent;border:none;color:var(--txt);border-radius:8px;cursor:pointer;text-align:left;transition:.15s}
  .sort-opt:hover{background:var(--panel-2)}
  .sort-opt.active{background:rgba(91,149,255,.14);color:var(--accent-2)}
  .sort-opt .s-ico{flex:none;width:22px;height:22px;display:inline-flex;align-items:center;justify-content:center;color:var(--muted);align-self:flex-start;padding-top:1px}
  .sort-opt .s-ico svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
  .sort-opt.active .s-ico{color:var(--accent-2)}
  .sort-opt .name{flex:1;display:flex;flex-direction:column;gap:2px;min-width:0}
  .sort-opt .name .label{font-weight:700;font-size:14px}
  .sort-opt .name .desc{font-size:11.5px;font-weight:500;color:var(--muted);letter-spacing:0;line-height:1.35}
  .sort-opt.active .name .desc{color:var(--accent-2);opacity:.85}
  .sort-opt .check{margin-left:auto;color:var(--accent-2);opacity:0;transition:.15s;width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2.6;align-self:flex-start;padding-top:3px;flex:none}
  .sort-opt.active .check{opacity:1}
  #notesViewMenu{min-width:260px}

  @keyframes cardEnter{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
  body.app-ready #cardCredentials,body.app-ready #cardServers,body.app-ready #notesCard{animation:cardEnter .5s cubic-bezier(.2,.9,.3,1) backwards}
  body.app-ready #cardCredentials{animation-delay:.04s}
  body.app-ready #cardServers{animation-delay:.12s}
  body.app-ready #notesCard{animation-delay:.20s}

  .card{background:linear-gradient(180deg,rgba(255,255,255,.025),rgba(255,255,255,0));border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;box-shadow:0 24px 60px -30px rgba(0,0,0,.7);margin-bottom:18px;transition:box-shadow .25s ease,transform .25s ease,border-color .25s ease}
  .card:hover{transform:translateY(-2px);box-shadow:0 32px 72px -30px rgba(0,0,0,.85)}
  html[data-theme="light"] .card,html[data-theme="solarized"] .card{background:#fff;box-shadow:0 24px 60px -30px rgba(0,0,0,.15)}
  html[data-theme="light"] .card:hover,html[data-theme="solarized"] .card:hover{box-shadow:0 32px 72px -30px rgba(0,0,0,.22)}
  .card-head{display:flex;align-items:center;justify-content:space-between;padding:14px 20px;border-bottom:1px solid var(--line-soft);background:rgba(255,255,255,.025);gap:12px;flex-wrap:wrap;cursor:pointer;user-select:none;transition:background .15s ease}
  .card-head:hover{background:rgba(91,149,255,.06)}
  .card.collapsed .card-head{border-bottom-color:transparent}
  .card-head-left{display:flex;align-items:center;gap:12px;min-width:0;flex-wrap:wrap}
  .card-head-right{display:flex;align-items:center;gap:8px;flex-wrap:wrap;cursor:default;justify-content:flex-end}
  .card-head-right input{cursor:text}
  .card-head h2{margin:0;font-size:15px;font-weight:800;color:var(--txt);text-transform:uppercase;letter-spacing:1.2px;display:flex;align-items:center;gap:10px}
  .card-head h2 svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:2.2}
  .card-collapse-btn{flex:none;width:36px;height:36px;display:inline-flex;align-items:center;justify-content:center;border-radius:9px;border:1px solid transparent;background:transparent;color:var(--muted);cursor:pointer;padding:0;transition:.15s}
  .card-collapse-btn:hover{color:var(--accent-2);background:rgba(91,149,255,.14);border-color:rgba(91,149,255,.4)}
  .card-collapse-btn svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:2.8;stroke-linecap:round;stroke-linejoin:round;transition:transform .3s cubic-bezier(.2,.9,.3,1.15)}
  .card.collapsed .card-collapse-btn svg{transform:rotate(-90deg)}
  .card-body-wrap{display:grid;grid-template-rows:1fr;transition:grid-template-rows .32s cubic-bezier(.2,.9,.3,1.15)}
  .card.collapsed .card-body-wrap{grid-template-rows:0fr}
  .card-body-inner{overflow:hidden;min-height:0}
  .count{font-size:13px;font-weight:800;color:var(--accent-2);background:rgba(91,149,255,.16);border:1px solid rgba(91,149,255,.4);border-radius:20px;padding:4px 12px;letter-spacing:.4px}
  .count.servers{color:var(--ok);background:rgba(61,220,132,.14);border-color:rgba(61,220,132,.4)}
  .count.notes{color:var(--warn);background:rgba(255,204,0,.14);border-color:rgba(255,204,0,.4)}

  .notes-card .card-head-right{gap:6px;row-gap:8px}
  .notes-card .card-head-right .sort-btn,
  .notes-card .card-head-right .add-btn,
  .notes-card .card-head-right .reset-sort-btn{height:34px;padding:0 10px;font-size:12.5px;letter-spacing:.2px}
  .notes-card .card-head-right .sort-btn svg,
  .notes-card .card-head-right .add-btn svg,
  .notes-card .card-head-right .reset-sort-btn svg{width:13px;height:13px}
  .notes-card .card-head-right .search-wrap input{height:34px;width:120px;padding:0 10px 0 30px;font-size:13px}
  .notes-card .card-head-right .search-wrap input:focus{width:170px}
  .notes-card .card-head-right .search-wrap svg{width:13px;height:13px;left:10px}

  .backup-banner{display:flex;align-items:center;gap:12px;padding:12px 16px;margin-bottom:14px;border-radius:12px;border:1px solid rgba(255,204,0,.5);background:linear-gradient(180deg,rgba(255,204,0,.14),rgba(255,204,0,.05));color:var(--txt);font-size:14px;font-weight:600;box-shadow:0 18px 40px -24px rgba(0,0,0,.6)}
  .backup-banner svg{width:18px;height:18px;flex:none;stroke:var(--warn);fill:none;stroke-width:2.2}
  .backup-banner #backupMsg{flex:1;min-width:0}
  .backup-banner #backupMsg b{color:var(--warn);font-weight:800}
  .backup-banner button{padding:8px 14px;border-radius:8px;border:1px solid transparent;background:linear-gradient(180deg,var(--accent),#3d7bf0);color:#fff;font-family:inherit;font-size:13.5px;font-weight:700;cursor:pointer;transition:.15s;display:inline-flex;align-items:center;gap:6px;flex:none}
  .backup-banner button:hover{filter:brightness(1.1)}
  .backup-banner button.ghost{background:transparent;border-color:var(--line);color:var(--muted)}
  .backup-banner button.ghost:hover{background:var(--panel-2);color:var(--txt);filter:none}
  .pwd-banner{border-color:rgba(61,220,132,.5);background:linear-gradient(180deg,rgba(61,220,132,.14),rgba(61,220,132,.05))}
  .pwd-banner svg{stroke:var(--ok)}
  .pwd-banner #pwdBannerMsg b{color:var(--ok)}
  .pwd-banner button.pwd-set{background:linear-gradient(180deg,#3ddc84,#25b86a);color:#04210f}

  .add-btn{display:inline-flex;align-items:center;gap:7px;font-size:14px;font-weight:700;padding:9px 15px;border-radius:9px;border:1px solid transparent;background:linear-gradient(180deg,var(--accent),#3d7bf0);color:#fff;cursor:pointer;transition:.15s;box-shadow:0 6px 18px -10px rgba(91,149,255,.85);font-family:inherit}
  .add-btn svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2.6}
  .add-btn:hover{filter:brightness(1.1)}
  .add-btn.active{background:var(--panel-2);border-color:var(--line);color:var(--muted);box-shadow:none}
  .add-btn.servers{background:linear-gradient(180deg,var(--accent),#3d7bf0);color:#fff;box-shadow:0 6px 18px -10px rgba(91,149,255,.85)}
  .add-btn.servers.active{background:var(--panel-2);border-color:var(--line);color:var(--muted);box-shadow:none}
  .add-btn.notes{background:linear-gradient(180deg,var(--accent),#3d7bf0);color:#fff;box-shadow:0 6px 18px -10px rgba(91,149,255,.85)}
  .add-btn.notes:hover{filter:brightness(1.1)}
  .sort-btn{display:inline-flex;align-items:center;gap:7px;height:38px;padding:0 12px;font-size:13.5px;font-weight:700;border-radius:9px;border:1px solid var(--line);background:var(--panel-2);color:var(--txt);cursor:pointer;transition:.15s;font-family:inherit;letter-spacing:.3px}
  .sort-btn svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
  .sort-btn:hover{border-color:var(--accent);color:var(--accent-2);background:rgba(91,149,255,.12)}
  .sort-btn.active{border-color:var(--accent);color:var(--accent-2);background:rgba(91,149,255,.18)}
  @keyframes sortSpin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
  #sortIcon.spin{animation:sortSpin .45s cubic-bezier(.2,.9,.3,1.2)}
  .reset-sort-btn{display:inline-flex;align-items:center;gap:6px;height:38px;padding:0 12px;border-radius:9px;border:1px dashed var(--warn);background:rgba(255,204,0,.1);color:var(--warn);font-family:inherit;font-size:13px;font-weight:700;cursor:pointer;transition:.15s;letter-spacing:.3px}
  .reset-sort-btn:hover{background:rgba(255,204,0,.22)}
  .reset-sort-btn svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2.4}
  .search-wrap{position:relative;display:inline-flex;align-items:center}
  .search-wrap svg{position:absolute;left:11px;width:15px;height:15px;stroke:var(--muted);fill:none;stroke-width:2.2;pointer-events:none}
  .search-wrap input{height:38px;width:180px;padding:0 12px 0 34px;background:var(--panel-2);border:1px solid var(--line);border-radius:9px;color:var(--txt);font-family:inherit;font-size:14px;outline:none;transition:border-color .15s,box-shadow .15s,width .15s;cursor:text}
  .search-wrap input::-webkit-search-cancel-button{filter:invert(.6)}
  .search-wrap input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(91,149,255,.2);width:220px}
  .add-panel{padding:10px 20px;border-bottom:1px solid var(--line-soft);background:rgba(0,0,0,.18);animation:slide .18s ease-out}
  html[data-theme="light"] .add-panel,html[data-theme="solarized"] .add-panel{background:var(--panel-2)}
  @keyframes slide{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}
  .add-form{display:flex;gap:10px;flex-wrap:wrap}
  .add-form input{flex:1;min-width:130px;background:var(--panel-2);border:1px solid var(--line);border-radius:9px;color:var(--txt);padding:10px 14px;font-size:15px;font-family:inherit;outline:none;transition:border-color .15s,box-shadow .15s}
  .add-form input::placeholder{color:var(--muted);opacity:.75}
  .add-form input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(91,149,255,.2)}
  .add-form button{padding:10px 18px;border-radius:9px;border:1px solid var(--line);background:var(--panel-2);color:var(--txt);font-family:inherit;font-size:14px;font-weight:700;cursor:pointer;transition:.15s;display:inline-flex;align-items:center;gap:7px}
  .add-form button:hover{background:var(--panel);border-color:var(--accent)}
  .add-form button.primary{background:linear-gradient(180deg,var(--accent),#3d7bf0);border-color:transparent;color:#fff;box-shadow:0 6px 18px -10px rgba(91,149,255,.85)}
  .add-form button.primary:hover{filter:brightness(1.1)}
  .add-form button svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2.6}
  .add-form button.ghost{background:transparent;color:var(--muted)}
  .add-form button.ghost:hover{color:var(--txt)}

  table{width:100%;border-collapse:collapse;table-layout:fixed}
  thead th{text-align:left;font-size:12px;font-weight:800;letter-spacing:1px;text-transform:uppercase;color:var(--muted);padding:8px 18px;background:rgba(255,255,255,.02);border-bottom:1px solid var(--line-soft);white-space:nowrap}
  html[data-theme="light"] thead th,html[data-theme="solarized"] thead th{background:var(--panel-2)}
  thead th.col-actions{text-align:right}
  thead th .th-inner{display:inline-flex;align-items:center;gap:7px}
  thead th .th-inner svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2.2}

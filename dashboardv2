  .note[data-color="star"]{background-color:#0e1230;background-image:radial-gradient(1px 1px at 12% 25%,rgba(255,255,255,.85),transparent),radial-gradient(1.5px 1.5px at 45% 12%,rgba(255,255,255,.75),transparent),radial-gradient(1px 1px at 78% 30%,rgba(255,255,255,.8),transparent),radial-gradient(1px 1px at 25% 62%,rgba(255,255,255,.65),transparent),radial-gradient(1.5px 1.5px at 62% 78%,rgba(255,255,255,.7),transparent),radial-gradient(1px 1px at 88% 55%,rgba(255,255,255,.7),transparent),radial-gradient(1px 1px at 38% 88%,rgba(255,255,255,.6),transparent),radial-gradient(1px 1px at 72% 45%,rgba(255,255,255,.55),transparent),radial-gradient(circle at 30% 20%,rgba(120,150,255,.18),transparent 55%),linear-gradient(180deg,rgba(25,30,70,.55),rgba(10,15,40,.35))}

      const margin = 10;
      let nx = s.startLeft + dx;
      let ny = s.startTop + dy;
      nx = Math.max(margin, Math.min(cw - nw - margin, nx));
      ny = Math.max(margin, ny);
      s.currentX = nx; s.currentY = ny;
      s.el.style.left = nx + 'px';
      s.el.style.top = ny + 'px';
      return;
    }
    if(!s.active&&(Math.abs(dx)>6||Math.abs(dy)>6))activateNoteDrag();
    if(!s.active)return;
    e.preventDefault();
    s.el.style.left=(e.clientX-s.offsetX)+'px';
    s.el.style.top=(e.clientY-s.offsetY)+'px';
    const t=document.elementFromPoint(e.clientX,e.clientY);if(!t)return;
    const tn=t.closest&&t.closest('.note:not(.dragging-note)');
    const ph=s.placeholder;
    if(tn&&tn!==ph){
      const par=tn.parentNode;if(!par)return;
      const tr=tn.getBoundingClientRect();
      const before=e.clientX<tr.left+tr.width/2;
      const ref=before?tn:tn.nextSibling;
      if(ph.parentNode!==par||ph.nextSibling!==ref)par.insertBefore(ph,ref);

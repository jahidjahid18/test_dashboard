    let L=s.startLeft,T=s.startTop,W=s.startW,H=s.startH;
    if(s.dir.indexOf('e')!==-1)W=s.startW+dx;
    if(s.dir.indexOf('w')!==-1){W=s.startW-dx;L=s.startLeft+dx;}
    if(s.dir.indexOf('s')!==-1)H=s.startH+dy;
    if(s.dir.indexOf('n')!==-1){H=s.startH-dy;T=s.startTop+dy;}
    if(W<s.minW){if(s.dir.indexOf('w')!==-1)L=s.startLeft+(s.startW-s.minW);W=s.minW;}
    if(W>s.maxW)W=s.maxW;

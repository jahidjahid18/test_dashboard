  async function handleSecSubmit(){
    if(!secMode)return;

    if(secMode==='idle'){
      hideSecurityModal();isLocked=false;resetIdleTimer();
      return;
    }

    if(secMode==='unlock'){
      const p=($('secPwd1')||{}).value||'';
      if(!p){showSecError('Please enter your password.');return;}
      secPrimary.disabled=true;
      try{
        const r=await verifyPasswordAnyFormat(p);
        if(!r.ok){showSecError('Incorrect password. Please try again.');return;}
        if(r.migrate){
          cryptoKey=null;
          await loadData();
          await setupEncryption(p);
          await Promise.all([saveCreds(),saveGroups(),saveNotes()]);
        } else {
          cryptoKey=r.key;
          await loadData();
        }
        hideSecurityModal();
        isLocked=false;
        if(!appStarted){appStarted=true;await startApp();}
        else{renderCredentials();renderServers();renderNotes();resetIdleTimer();}
        if(r.migrate)showToast('Password upgraded — data is now encrypted with AES-256');
      }catch(e){
        showSecError('Could not decrypt data: '+(e.message||e.name||'unknown'));
        cryptoKey=null;
      }finally{secPrimary.disabled=false;}
      return;
    }

    if(secMode==='set'){
      const p1=($('secPwd1')||{}).value||'';
      const p2=($('secPwd2')||{}).value||'';
      if(p1.length<6){showSecError('Password must be at least 6 characters.');return;}
      if(p1!==p2){showSecError('Passwords do not match.');return;}
      secPrimary.disabled=true;
      try{
        await setupEncryption(p1);
        await Promise.all([saveCreds(),saveGroups(),saveNotes()]);
        hideSecurityModal();
        showToast('Master password set — data encrypted with AES-256-GCM');
        updateSecurityUI();
      }catch(e){showSecError('Could not set password: '+(e.message||e.name));}
      finally{secPrimary.disabled=false;}
      return;
    }

    if(secMode==='change'){
      const p0=($('secPwd0')||{}).value||'';
      const p1=($('secPwd1')||{}).value||'';
      const p2=($('secPwd2')||{}).value||'';
      if(!p0){showSecError('Please enter your current password.');return;}
      if(p1.length<6){showSecError('New password must be at least 6 characters.');return;}
      if(p1!==p2){showSecError('New passwords do not match.');return;}
      secPrimary.disabled=true;
      try{
        const r=await verifyPasswordAnyFormat(p0);
        if(!r.ok){showSecError('Current password is incorrect.');return;}
        await setupEncryption(p1);
        await Promise.all([saveCreds(),saveGroups(),saveNotes()]);
        hideSecurityModal();
        showToast('Master password changed — data re-encrypted');
        updateSecurityUI();
      }catch(e){showSecError('Could not change password: '+(e.message||e.name));}
      finally{secPrimary.disabled=false;}
      return;
    }

    if(secMode==='remove'){
      const p0=($('secPwd0')||{}).value||'';
      if(!p0){showSecError('Please enter your current password.');return;}
      secPrimary.disabled=true;
      try{
        const r=await verifyPasswordAnyFormat(p0);
        if(!r.ok){showSecError('Incorrect password.');return;}
        clearEncryptionRecords();
        clearSessionUnlocked();
        cryptoKey=null;
        await Promise.all([saveCreds(),saveGroups(),saveNotes()]);
        try{localStorage.removeItem(PWD_BANNER_DISMISS_KEY);}catch(e){}
        hideSecurityModal();
        showToast('Master password removed — data is now stored unencrypted');
        updateSecurityUI();
        checkPasswordBanner();
      }catch(e){showSecError('Could not remove password: '+(e.message||e.name));}
      finally{secPrimary.disabled=false;}
      return;
    }
  }


  .notes-tab{display:inline-flex;align-items:center;gap:8px;padding:7px 13px;border-radius:20px;border:1px solid var(--line);background:var(--panel-2);color:var(--muted);font-family:inherit;font-size:13px;font-weight:700;letter-spacing:.2px;cursor:pointer;transition:.15s;max-width:280px;flex:none}

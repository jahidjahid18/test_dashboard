  function parseTxt(filename,text){
    let t=String(text||'').replace(/^\uFEFF/,'');
    let title=String(filename||'').replace(/\.(txt|md|log|csv|json)$/i,'').trim()||'Imported note';
    let body=t;
    const lines=t.split(/\r?\n/);
    let fi=0;while(fi<lines.length&&lines[fi].trim()==='')fi++;
    if(fi<lines.length&&/^#\s+/.test(lines[fi])){
      const poss=lines[fi].replace(/^#\s+/,'').trim();
      if(poss){title=poss;let si=fi+1;if(lines[si]&&/^Updated:\s/i.test(lines[si]))si++;while(si<lines.length&&lines[si].trim()==='')si++;body=lines.slice(si).join('\n');}
    }
    return{title,body};
  }

  .note-head{display:flex;align-items:center;gap:3px;padding:6px 8px;border-bottom:1px solid var(--line-soft);background:rgba(0,0,0,.14);cursor:grab;touch-action:none;user-select:none;transition:background .15s;position:relative;z-index:4}

  .sec-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;width:100%;height:48px;padding:0 20px;border-radius:10px;border:1px solid var(--line);background:var(--panel-2);color:var(--txt);font-family:inherit;font-size:15px;font-weight:800;cursor:pointer;transition:.15s;letter-spacing:.2px}

  async function verifyPasswordAnyFormat(pw){
    const saltB64=localStorage.getItem(MASTER_SALT_KEY);
    const iter=parseInt(localStorage.getItem(MASTER_ITER_KEY)||String(PBKDF2_ITER),10);
    const verifier=localStorage.getItem(VERIFIER_KEY);
    if(verifier && saltB64){
      try{
        const salt=b64Decode(saltB64);
        const key=await deriveKey(pw, salt, iter);
        if(await checkVerifier(verifier, key))return{ok:true, key, migrate:false};
      }catch(e){}
    }
    const hb=localStorage.getItem(MASTER_HASH_KEY);
    if(hb && saltB64){
      try{
        const sh=b64Decode(hb);
        const sa=b64Decode(saltB64);
        const th=await deriveHash(pw, sa, iter);
        if(timingSafeEqual(sh, th))return{ok:true, migrate:true};
      }catch(e){}
    }
    return{ok:false};
  }


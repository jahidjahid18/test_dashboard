.card .badge-time{position:absolute;top:var(--sp-2);right:calc(var(--sp-2) + 42px);z-index:3;font-size:10px;font-weight:700;padding:3px var(--sp-2);border-radius:var(--r-full);background:rgba(6,8,16,.72);border:1px solid rgba(255,255,255,.14);color:#dfe3ff;backdrop-filter:blur(8px);opacity:0;transform:translateY(-4px);transition:opacity var(--dur-med), transform var(--dur-med);pointer-events:none;font-variant-numeric:tabular-nums}

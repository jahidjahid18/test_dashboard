async function deleteImage(it, cardEl){
  const fileName = it.name;
  let deletedFromDisk = false;
  let failureReason = null;

  if (!state.handle || typeof state.handle.removeEntry !== 'function'){
    failureReason = 'no-handle';
  } else {
    try{
      let perm = 'unknown';
      if (state.handle.queryPermission){
        try{ perm = await state.handle.queryPermission({ mode:'readwrite' }); }catch(e){}
      }
      if (perm !== 'granted'){
        try{ perm = await state.handle.requestPermission({ mode:'readwrite' }); }catch(e){ perm = 'threw'; }
      }
      if (perm !== 'granted'){
        failureReason = 'permission-' + perm;
      } else {
        try{
          await deleteFileByRelPath(fileName);
          deletedFromDisk = true;
        }catch(delErr){
          failureReason = delErr && delErr.name ? delErr.name : 'delete-error';
        }
      }
    }catch(err){ failureReason = err && err.name ? err.name : 'unknown'; }
  }

  try{ if(it.url) URL.revokeObjectURL(it.url); }catch(e){}
  it.url = null;
  const idx = state.items.indexOf(it);
  if (idx >= 0) state.items.splice(idx, 1);
  state.favorites.delete(it.name);
  saveLocal('favs', [...state.favorites]);
  state.faceData.delete(it.name);
  state.hashes.delete(it.name);
  removeFromCustomOrder([it.name]);
  removeFromAdjust([it.name]);

  if (cardEl && cardEl.parentNode){
    cardEl.style.pointerEvents = 'none';
    cardEl.style.transition = 'opacity .22s ease, transform .22s ease';
    cardEl.style.opacity = '0';
    cardEl.style.transform = 'scale(.9)';
    setTimeout(() => {
      const section = cardEl.closest('.day-section, .sim-group');
      cardEl.remove();
      if (section && section.classList.contains('day-section') && !section.querySelector('.card')){
        section.style.transition = 'opacity .2s ease';
        section.style.opacity = '0';
        setTimeout(() => {
          if (section && !section.querySelector('.card')) section.style.display = 'none';
        }, 200);
      }
    }, 230);
  }

  scheduleUISync();

  if (deletedFromDisk) toast('Photo deleted', 'ok');
  else if (failureReason === 'no-handle') toast('Removed from view (folder not connected)', 'err');
  else if (failureReason && failureReason.indexOf('permission') === 0){
    if (location.protocol === 'file:') toast('Removed from view — file:// blocks disk delete', 'err');
    else toast('Removed from view — click Forget, then Open', 'err');
  } else if (failureReason === 'NotFoundError'){
    toast('Removed from view (file moved or renamed)', 'err');
  } else toast('Removed from view — ' + (failureReason || 'unknown'), 'err');
}

const REENCODEABLE = /\.(jpe?g|jfif|webp)$/i;
const PNG_RE = /\.png$/i;

function filterForBake(raw){ return buildFilter(raw) || 'none'; }

async function getOrientation(file){
  if (typeof exifr === 'undefined') return 1;
  try{
    const d = await exifr.parse(file, ['Orientation']);
    return (d && d.Orientation) || 1;
  }catch(e){ return 1; }
}
function applyOrientationToCanvas(canvas, ctx, img, orientation){
  const w = img.naturalWidth, h = img.naturalHeight;
  switch (orientation){
    case 2: canvas.width = w; canvas.height = h; ctx.translate(w,0); ctx.scale(-1,1); break;
    case 3: canvas.width = w; canvas.height = h; ctx.translate(w,h); ctx.rotate(Math.PI); break;
    case 4: canvas.width = w; canvas.height = h; ctx.translate(0,h); ctx.scale(1,-1); break;
    case 5: canvas.width = h; canvas.height = w; ctx.rotate(0.5*Math.PI); ctx.scale(1,-1); break;
    case 6: canvas.width = h; canvas.height = w; ctx.rotate(0.5*Math.PI); ctx.translate(0,-h); break;
    case 7: canvas.width = h; canvas.height = w; ctx.rotate(0.5*Math.PI); ctx.translate(w,-h); ctx.scale(-1,1); break;
    case 8: canvas.width = h; canvas.height = w; ctx.rotate(-0.5*Math.PI); ctx.translate(-w,0); break;
    default: canvas.width = w; canvas.height = h;
  }
}
async function bakeOnePhoto(it){
  if (!state.handle) throw new Error('no-folder');
  if (!state.writeGranted){
    const p = state.handle.requestPermission ? await state.handle.requestPermission({ mode:'readwrite' }) : 'denied';
    if (p !== 'granted') throw new Error('no-permission');
    state.writeGranted = true;
    updateWriteBadge();
  }
  const raw = state.adjust[it.name];
  if (isDefaultAdjust(raw)) return false;

  const parts = it.name.split('/').filter(Boolean);
  const filename = parts.pop();
  let dir = state.handle;
  for (const part of parts) dir = await dir.getDirectoryHandle(part);

  const isPng = PNG_RE.test(filename);
  const isJpeg = REENCODEABLE.test(filename);
  if (!isPng && !isJpeg) throw new Error('unsupported-format');

  const origFile = await (await dir.getFileHandle(filename)).getFile();
  const orientation = await getOrientation(origFile);

  let url = it.url;
  if (!url) url = URL.createObjectURL(it.file);

  const img = await loadImageEl(url);
  if (!img || !img.naturalWidth) throw new Error('decode-failed');

  const canvas = document.createElement('canvas');
  const ctx = canvas.getContext('2d', { alpha: isPng });
  applyOrientationToCanvas(canvas, ctx, img, orientation);
  ctx.filter = filterForBake(raw);
  ctx.drawImage(img, 0, 0);

  const mime = isPng ? 'image/png' : 'image/jpeg';
  const quality = isPng ? undefined : 0.95;
  const blob = await new Promise(res => canvas.toBlob(res, mime, quality));
  if (!blob) throw new Error('encode-failed');

  const fh = await dir.getFileHandle(filename, { create:true });
  const w = await fh.createWritable();
  await w.write(blob);
  await w.close();

  const newFile = await fh.getFile();
  const newUrl = URL.createObjectURL(newFile);

  if (it.url) URL.revokeObjectURL(it.url);

  it.url = newUrl;
  it.file = newFile;
  delete state.adjust[it.name];
  saveAdjust();
  state.ambientCache.delete(newUrl);
  state.exifCache.delete(it.name);
  state.hashes.delete(it.name);

  document.querySelectorAll(`.card[data-name="${CSS.escape(it.name)}"]`).forEach(card => {
    const cimg = card.querySelector('img');
    if (cimg){
      cimg.classList.remove('loaded');
      cimg.src = newUrl;
      cimg.addEventListener('load', () => cimg.classList.add('loaded'), { once:true });
      cimg.style.filter = '';
    }
    if (!card.querySelector('.edited-badge')){
      const eb = document.createElement('span');
      eb.className = 'edited-badge';
      eb.textContent = 'Edited';
      card.appendChild(eb);
    }
  });
  return true;
}

$('apApply').addEventListener('click', async () => {

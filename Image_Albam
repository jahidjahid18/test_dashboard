});

function removeFromCustomOrder(names){
  const set = names instanceof Set ? names : new Set(names);
  let changed = false;
  for (const key of Object.keys(state.customOrder)){
    const arr = state.customOrder[key];
    if (!Array.isArray(arr)) continue;
    const next = arr.filter(n => !set.has(n));
    if (next.length !== arr.length){
      changed = true;
      if (next.length) state.customOrder[key] = next;
      else delete state.customOrder[key];
    }
  }
  if (changed) saveLocal('order', state.customOrder);
}

async function loadFiles(entries, dirName, opts = {}){
  const useBusy = !!opts.busy;
  const tick = makeThrottledProgress(80);

  const normalized = entries.map(entry => {
    if (entry && entry.file){
      const base = entry.file.name;
      return { name: entry.name, basename: base, file: entry.file };
    }
    const f = entry;
    const rel = f.webkitRelativePath && f.webkitRelativePath.length ? f.webkitRelativePath : f.name;
    const parts = rel.split('/');
    const name = parts.length > 1 ? parts.slice(1).join('/') : rel;
    return { name, basename: f.name, file: f };
  }).filter(e => IMG_RE.test(e.basename));

  if (!normalized.length){
    if (useBusy) hideBusy();
    toast('No images found in that folder', 'err');
    return;
  }

  if (useBusy){
    showBusy('Preparing photos…', `0 / ${compactFmt.format(normalized.length)}`);
  }

  state.items.forEach(it => { try{ if(it.url) URL.revokeObjectURL(it.url); }catch(e){} });
  state.items = [];
  state.view = [];
  state.exifCache.clear();
  state.ambientCache.clear();
  state.selection.clear();
  state.lastAnchor = null;
  state.faceData.clear();
  state.people = [];
  state.itemPeople.clear();
  state.filter.personId = null;
  state.filter.similar = false;
  state.faceSource = null;
  state.hashes.clear();
  state.simGroups = [];
  state.simBusy = false;
  state.openYears.clear();
  state.openMonths.clear();

  const total = normalized.length;
  const built = new Array(total);
  for (let i = 0; i < total; i++){
    if (state.busyCancelled) {
      if (useBusy) hideBusy();
      return;
    }
    const entry = normalized[i];
    const meta = parseMeta(entry.file);
    built[i] = {
      name: entry.name, basename: entry.basename,
      url: URL.createObjectURL(entry.file),
      file: entry.file,
      ...meta
    };
    if (useBusy && ((i & 127) === 0 || i === total - 1)){
      tick('Preparing photos…', `${compactFmt.format(i + 1)} / ${compactFmt.format(total)}`, ((i + 1) / total) * 100, true);
      await new Promise(r => setTimeout(r, 0));
    }
  }

  if (state.busyCancelled) {
    if (useBusy) hideBusy();
    return;
  }

  state.items = built.sort((a, b) => b.ts - a.ts);

  if (dirName) state.dirName = dirName;
  const label = state.dirName || '';
  $('folderChipName').textContent = label;

  state.favorites = new Set(loadLocal('favs', []));
  state.customOrder = loadLocal('order', {});
  state.coverName = loadLocal('cover', null);
  state.adjust = loadLocal(ADJUST_KEY, {}) || {};

  if (state.items.length){
    const first = state.items[0];
    state.openYears.add(first.y);
    state.openMonths.add(first.y + '-' + first.mo);
  }
  resetFilters(false);
  renderAll();
  renderPeople();
  updateFavBadge();
  updateSelectionBar();
  checkWritePermission();
  if (useBusy) hideBusy();
  toast('Loaded ' + state.items.length + ' photo' + (state.items.length > 1 ? 's' : ''), 'ok');

  const MEASURE_TITLE = 'Reading photo sizes…';
  const showMeasureJob = state.items.length > 400;
  if (showMeasureJob) jobProgress.show(MEASURE_TITLE, `0 / ${compactFmt.format(state.items.length)}`);

  measureAll(state.items, (done, tot) => {
    if (!showMeasureJob) return;
    jobProgress.update(MEASURE_TITLE, `${compactFmt.format(done)} / ${compactFmt.format(tot)}`, (done / Math.max(tot, 1)) * 100);
  }).then(() => {
    if (showMeasureJob){
      setTimeout(() => {
        if (!jobProgress.titleEl || jobProgress.titleEl.textContent === MEASURE_TITLE) jobProgress.hide();
      }, 400);
    }
    if (state.layout === 'justified' && state.items.length) renderAll();
  });

  loadFaceData().then(async () => {
    if (state.faceData.size){
      state.faceDist = loadFaceDist();
      updateSensitivityUI();
      await rebuildPeople();
    } else {
      renderPeople();
      updateSensitivityUI();
    }
  });
}

async function readDirectory(dirHandle, prefix = '', onFound = null){
  const out = [];
  try{
    for await (const entry of dirHandle.values()){
      if (state.busyCancelled) throw new Error('cancelled');
      if (entry.name.startsWith('.')) continue;
      if (entry.kind === 'file'){
        if (IMG_RE.test(entry.name)){
          try{
            const file = await entry.getFile();
            out.push({ name: prefix + entry.name, file });
            if (onFound) onFound(prefix + entry.name);
          }catch(e){}
        }
      } else if (entry.kind === 'directory'){
        out.push(...await readDirectory(entry, prefix + entry.name + '/', onFound));
      }
    }
  }catch(e){
    if (e.message === 'cancelled') throw e;
  }
  return out;
}
async function loadFromHandle(handle){
  if (busyBackdrop.classList.contains('open')) return;
  showBusy('Scanning folder…', 'Looking for images…');
  setBusyIndeterminate(true);
  const tick = makeThrottledProgress(90);
  let found = 0;
  try{
    const files = await readDirectory(handle, '', (relName) => {
      found++;
      tick(
        'Scanning folder…',
        `${compactFmt.format(found)} image${found === 1 ? '' : 's'} found · ${truncatePath(relName, 44)}`
      );
    });

    if (state.busyCancelled) throw new Error('cancelled');

    if (!files.length){
      hideBusy();
      toast('No images in that folder');
      renderAll();
      return;
    }
    updateBusy('Scanning folder…', `${compactFmt.format(files.length)} image${files.length === 1 ? '' : 's'} found`, 100);
    state.handle = handle;
    await loadFiles(files, handle.name, { busy: true });
  }catch(err){
    if (err.message === 'cancelled' || state.busyCancelled) {
      hideBusy();
      state.handle = null;
      updateWriteBadge();
      renderAll();
      return;
    }
    console.error(err);
    hideBusy();
    toast('Could not read folder — try Open again', 'err');
    renderAll();
  }
}
async function deleteFileByRelPath(relPath){
  if (!state.handle) throw new Error('no-handle');
  const parts = relPath.split('/').filter(Boolean);
  const filename = parts.pop();
  let dir = state.handle;
  for (const part of parts){ dir = await dir.getDirectoryHandle(part); }
  await dir.removeEntry(filename);
}

async function getSavedHandles() {

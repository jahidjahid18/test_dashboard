.fav-btn{position:absolute;top:var(--sp-2);left:var(--sp-2);z-index:5;width:36px;height:36px;border-radius:50%;display:grid;place-items:center;border:1px solid rgba(255,255,255,.18);background:rgba(6,8,16,.55);backdrop-filter:blur(8px);color:rgba(255,255,255,.75);cursor:pointer;transition:opacity var(--dur-med), transform var(--dur-med) var(--ease-spring), background var(--dur-fast), color var(--dur-fast), border-color var(--dur-fast);opacity:0;transform:translateY(-4px)}

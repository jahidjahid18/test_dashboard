const ADJUST_KEY = 'adjust';

function defaultAdjust(){ return { b:0, c:0, s:0, w:0, g:false }; }
function isDefaultAdjust(raw){
  if (!raw) return true;
  return !raw.b && !raw.c && !raw.s && !raw.w && !raw.g;
}
function buildFilter(raw){
  if (!raw || isDefaultAdjust(raw)) return '';
  const parts = [];
  if (raw.b) parts.push(`brightness(${(1 + raw.b / 130).toFixed(3)})`);
  if (raw.c) parts.push(`contrast(${(1 + raw.c / 150).toFixed(3)})`);
  if (raw.g) parts.push('grayscale(1)');
  else if (raw.s) parts.push(`saturate(${(1 + raw.s / 100).toFixed(3)})`);
  if (raw.w > 0){
    parts.push(`sepia(${(raw.w / 100 * 0.45).toFixed(3)})`);
    parts.push(`saturate(${(1 + raw.w / 100 * 0.20).toFixed(3)})`);
  } else if (raw.w < 0){
    const t = -raw.w / 100;
    parts.push(`sepia(${(t * 0.30).toFixed(3)})`);
    parts.push(`hue-rotate(${(t * 180).toFixed(1)}deg)`);
  }
  return parts.join(' ');

const SIM_KEY = 'album-sim-threshold';
const HASH_IDB_PREFIX = 'hashes-v1:';
const SIM_AR_TOL = 0.16;
function hashKey(){ return HASH_IDB_PREFIX + (state.dirName || 'default'); }
const _hashCanvas = document.createElement('canvas');
const _hashCtx = _hashCanvas.getContext('2d', { willReadFrequently: true });
function popcount32(x){
  x = x - ((x >>> 1) & 0x55555555);
  x = (x & 0x33333333) + ((x >>> 2) & 0x33333333);
  x = (x + (x >>> 4)) & 0x0f0f0f0f;
  return (x * 0x01010101) >>> 24;
}
function hexToU32(hex){
  const s = String(hex || '').padEnd(16, '0');
  return [parseInt(s.slice(8,16), 16) >>> 0, parseInt(s.slice(0,8), 16) >>> 0];
}
function bitsToHex(bits){
  let out = '';
  for (let i = 0; i < bits.length; i += 4) out += parseInt(bits.slice(i, i+4), 2).toString(16);
  return out;
}
function fmtBytes(n){
  if (n == null) return '';
  if (n < 1024) return n + ' B';
  if (n < 1024 * 1024) return (n / 1024).toFixed(0) + ' KB';
  return (n / 1024 / 1024).toFixed(1) + ' MB';
}
async function computeImageHash(it){
  let src = null, bmp = null;
  if (it.file && typeof createImageBitmap === 'function'){
    try{
      bmp = await createImageBitmap(it.file, { resizeWidth: 96, resizeQuality: 'high', imageOrientation: 'from-image' });
      src = bmp;
    }catch(e){ bmp = null; }
  }
  if (!src){
    if (!it.url) return null;
    const img = await loadImageEl(it.url);
    if (!img || !img.naturalWidth) return null;
    src = img;
  }
  let out = null;
  try{
    _hashCanvas.width = 9; _hashCanvas.height = 8;
    _hashCtx.drawImage(src, 0, 0, 9, 8);
    const dd = _hashCtx.getImageData(0, 0, 9, 8).data;
    const g = new Float32Array(72);
    for (let i = 0; i < 72; i++) g[i] = dd[i*4]*0.299 + dd[i*4+1]*0.587 + dd[i*4+2]*0.114;
    let dBits = '';
    for (let y = 0; y < 8; y++) for (let x = 0; x < 8; x++) dBits += (g[y*9 + x] > g[y*9 + x + 1]) ? '1' : '0';
    _hashCanvas.width = 8; _hashCanvas.height = 8;
    _hashCtx.drawImage(src, 0, 0, 8, 8);
    const ad = _hashCtx.getImageData(0, 0, 8, 8).data;
    const ag = new Float32Array(64);
    let sum = 0;
    for (let i = 0; i < 64; i++){
      ag[i] = ad[i*4]*0.299 + ad[i*4+1]*0.587 + ad[i*4+2]*0.114;
      sum += ag[i];
    }
    const mean = sum / 64;
    let aBits = '';
    for (let i = 0; i < 64; i++) aBits += (ag[i] > mean) ? '1' : '0';
    out = { d: bitsToHex(dBits), a: bitsToHex(aBits), w: 0, h: 0 };
  }catch(err){ out = null; }
  if (bmp && bmp.close){ try{ bmp.close(); }catch(e){} }
  if (out){
    if (it.w && it.h){ out.w = it.w; out.h = it.h; }
    else if (it.url) {
      const dim = await measureImage(it.url);
      it.w = dim.w; it.h = dim.h;
      out.w = dim.w; out.h = dim.h;
    }
    out.size = it.file ? it.file.size : 0;
    out.mtime = it.file ? it.file.lastModified : 0;
  }
  return out;
}
async function saveHashData(){
  if (!state.hashes.size) return;
  const items = {};
  for (const [name, h] of state.hashes) items[name] = { d: h.d, a: h.a, w: h.w, h: h.h, size: h.size, mtime: h.mtime };
  try{ await idbSet(hashKey(), { v: 1, items, saved: Date.now() }); }catch(e){ console.warn(e); }
}
async function loadHashData(){
  state.hashes.clear();
  try{
    const obj = await idbGet(hashKey());
    if (obj && obj.v === 1 && obj.items){
      for (const [name, h] of Object.entries(obj.items)) state.hashes.set(name, h);
    }
  }catch(e){}
}
async function ensureHashes(){
  await loadHashData();
  const todo = [];
  for (const it of state.items){
    const h = state.hashes.get(it.name);
    const size = it.file ? it.file.size : 0;
    const mtime = it.file ? it.file.lastModified : 0;
    if (!h || h.size !== size || h.mtime !== mtime) todo.push(it);
  }
  if (!todo.length) return true;
  jobProgress.show('Analyzing photos…', `0 / ${todo.length}`);
  let done = 0;
  for (const it of todo){
    try{
      const h = await computeImageHash(it);
      if (h) state.hashes.set(it.name, h);
    }catch(e){ console.warn('hash failed', it.name, e); }
    done++;
    if (done % 10 === 0 || done === todo.length){
      jobProgress.update('Analyzing photos…', `${done} / ${todo.length}`, (done / todo.length) * 100);
      await new Promise(r => setTimeout(r, 0));
    }
  }
  jobProgress.update('Saving fingerprints…', `${state.hashes.size} photos`, 100);
  await saveHashData();
  setTimeout(() => jobProgress.hide(), 500);
  return true;
}
async function computeSimilarGroups(onProgress){
  const recs = [];
  for (const it of state.items){
    const h = state.hashes.get(it.name);
    if (!h || !h.d) continue;
    const ar = (h.w && h.h) ? (h.w / h.h) : 1.5;
    const [dLo, dHi] = hexToU32(h.d);
    const [aLo, aHi] = hexToU32(h.a || h.d);
    recs.push({ it, ar, dLo, dHi, aLo, aHi });
  }
  recs.sort((a, b) => a.ar - b.ar);
  const n = recs.length;
  const parent = new Int32Array(n);
  for (let i = 0; i < n; i++) parent[i] = i;
  const find = x => { while (parent[x] !== x){ parent[x] = parent[parent[x]]; x = parent[x]; } return x; };
  const union = (a, b) => { a = find(a); b = find(b); if (a !== b) parent[b] = a; };
  const T = state.simThreshold;
  const CH = 128;
  for (let i = 0; i < n; i++){
    const A = recs[i];
    for (let j = i + 1; j < n; j++){
      const B = recs[j];
      if (B.ar - A.ar > SIM_AR_TOL) break;
      const dd = popcount32((A.dLo ^ B.dLo) >>> 0) + popcount32((A.dHi ^ B.dHi) >>> 0);
      if (dd > T) continue;
      const da = popcount32((A.aLo ^ B.aLo) >>> 0) + popcount32((A.aHi ^ B.aHi) >>> 0);
      if (da > T + 8) continue;
      union(i, j);
    }
    if ((i & (CH - 1)) === 0){
      if (onProgress) onProgress(i / Math.max(n, 1));
      await new Promise(r => setTimeout(r, 0));
    }
  }
  const map = new Map();
  for (let i = 0; i < n; i++){
    const r = find(i);
    if (!map.has(r)) map.set(r, []);
    map.get(r).push(recs[i].it);
  }
  const groups = [];
  for (const g of map.values()) if (g.length > 1) groups.push(g);
  groups.sort((a, b) => b.length - a.length || b[0].ts - a[0].ts);
  if (onProgress) onProgress(1);
  return groups;
}
async function rebuildSimGroups(){
  if (!state.hashes.size){ state.simGroups = []; return; }
  const showJob = state.items.length > 1200;
  if (showJob) jobProgress.show('Comparing photos…', '');
  state.simGroups = await computeSimilarGroups(pct => {
    if (showJob) jobProgress.update('Comparing photos…', Math.round(pct * 100) + '%', pct * 100);
  });
  if (showJob) setTimeout(() => jobProgress.hide(), 400);
}
function pruneSimGroups(){
  const names = new Set(state.items.map(i => i.name));
  state.simGroups = state.simGroups.map(g => g.filter(it => names.has(it.name))).filter(g => g.length > 1);
}
function pickBestSim(group){
  let best = group[0], bestScore = -1;
  for (const it of group){
    const px = (it.w || 0) * (it.h || 0);
    const bytes = (it.file && it.file.size) || 0;
    const score = px * 4096 + bytes;
    if (score > bestScore){ bestScore = score; best = it; }
  }
  return best;
}
function updateSimilarBtn(){
  const b = $('similarBtn');
  if (!b) return;
  const on = !!state.filter.similar;
  b.classList.toggle('active-mode', on);

async function batchDelete(names){
  if (!names.length) return;
  const cardsByNames = new Map();
  document.querySelectorAll('.card').forEach(c => {
    if (names.indexOf(c.dataset.name) >= 0) cardsByNames.set(c.dataset.name, c);
  });

  let canDeleteFromDisk = false;
  if (state.handle && typeof state.handle.removeEntry === 'function'){
    try{
      let perm = 'unknown';
      if (state.handle.queryPermission){
        try{ perm = await state.handle.queryPermission({ mode:'readwrite' }); }catch(e){}
      }
      if (perm !== 'granted'){
        try{ perm = await state.handle.requestPermission({ mode:'readwrite' }); }catch(e){ perm = 'threw'; }
      }
      canDeleteFromDisk = (perm === 'granted');
    }catch(e){ canDeleteFromDisk = false; }
  }

  let okCount = 0, failCount = 0;
  for (const name of names){
    const item = state.items.find(it => it.name === name);
    if (!item) continue;
    if (canDeleteFromDisk){
      try{ await deleteFileByRelPath(name); okCount++; }
      catch(err){ console.warn('Batch delete failed for', name, err); failCount++; }
    }
    try{ if(item.url) URL.revokeObjectURL(item.url); }catch(e){}
    item.url = null;
    const idx = state.items.indexOf(item);
    if (idx >= 0) state.items.splice(idx, 1);
    state.favorites.delete(item.name);
    state.faceData.delete(item.name);
    state.hashes.delete(item.name);
  }
  saveLocal('favs', [...state.favorites]);
  removeFromCustomOrder(names);
  removeFromAdjust(names);

  cardsByNames.forEach(card => {
    card.style.pointerEvents = 'none';
    card.style.transition = 'opacity .22s ease, transform .22s ease';
    card.style.opacity = '0';
    card.style.transform = 'scale(.9)';
  });

  setTimeout(() => {
    cardsByNames.forEach(card => {
      const section = card.closest('.day-section, .sim-group');
      card.remove();
      if (section && section.classList.contains('day-section') && !section.querySelector('.card')){
        section.style.transition = 'opacity .2s ease';
        section.style.opacity = '0';
        setTimeout(() => { if (section && !section.querySelector('.card')) section.style.display = 'none'; }, 200);
      }
    });
  }, 230);

  state.selection.clear();
  state.lastAnchor = null;
  updateSelectionBar();
  scheduleUISync();

  const total = names.length;
  if (canDeleteFromDisk && failCount === 0) toast(total + ' photo' + (total > 1 ? 's' : '') + ' deleted', 'ok');
  else if (canDeleteFromDisk && okCount > 0) toast(okCount + ' deleted, ' + failCount + ' failed', 'err');
  else if (location.protocol === 'file:') toast(total + ' removed from view — file:// blocks disk delete', 'err');
  else toast(total + ' removed from view (kept on disk)', 'err');
}


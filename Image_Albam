function makeMonthStrip(){
  if (!state.items.length) return null;
  const byMonth = new Map();
  for (const it of state.items){
    const k = it.y + '-' + pad(it.mo);
    if (!byMonth.has(k)) byMonth.set(k, []);
    byMonth.get(k).push(it);
  }
  if (byMonth.size < 2) return null;
  const keys = [...byMonth.keys()].sort((a,b) => b.localeCompare(a));

  const wrap = document.createElement('div');
  wrap.className = 'month-strip-wrap';
  const label = document.createElement('div');
  label.className = 'month-strip-label';
  label.textContent = 'Jump to month';
  wrap.appendChild(label);

  const strip = document.createElement('div');
  strip.className = 'month-strip';
  strip.setAttribute('role','list');

  for (const k of keys){
    const [ys, ms] = k.split('-');
    const y = +ys, mo = +ms;
    const list = byMonth.get(k);
    const cover = list[0];
    if (!cover || !cover.url) continue;

    const card = document.createElement('button');
    card.className = 'month-card';
    card.dataset.monthkey = k;
    card.dataset.name = cover.name;
    card.setAttribute('role','listitem');
    card.innerHTML = `
      <img src="${cover.url}" alt="" loading="lazy" decoding="async">
      <span class="mc-count">${compactFmt.format(list.length)}</span>
      <div class="month-card-info">
        <div class="mc-month">${MONTHS[mo-1]}</div>
        <div class="mc-year">${y}</div>
      </div>`;
    card.addEventListener('click', () => {
      const band = contentEl.querySelector(`[data-monthkey="${k}"]`);
      if (band) band.scrollIntoView({ behavior:'smooth', block:'start' });
    });
    strip.appendChild(card);
  }
  wrap.appendChild(strip);
  return wrap;
}

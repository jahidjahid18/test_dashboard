.sim-sens input[type="range"]{width:130px;height:18px;-webkit-appearance:none;appearance:none;background:transparent;cursor:pointer;outline:none}
.sim-sens input[type="range"]::-webkit-slider-runnable-track{height:3px;border-radius:99px;background:var(--stroke-strong)}
.sim-sens input[type="range"]::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;width:14px;height:14px;border-radius:50%;background:var(--accent-2);margin-top:-5.5px;box-shadow:0 0 0 2px var(--bg), 0 0 8px color-mix(in srgb,var(--accent-2) 60%,transparent)}
.sim-sens input[type="range"]::-moz-range-track{height:3px;border-radius:99px;background:var(--stroke-strong)}
.sim-sens input[type="range"]::-moz-range-thumb{width:14px;height:14px;border:none;border-radius:50%;background:var(--accent-2)}
.sim-sens .val{font-variant-numeric:tabular-nums;color:var(--accent-2);min-width:18px;text-align:right}
.sim-actions{display:flex;gap:var(--sp-2);flex-wrap:wrap;margin-left:auto}
.sim-actions .btn{min-height:34px;padding:var(--sp-1) var(--sp-4);font-size:12.5px}
.sim-group{margin:var(--sp-5) var(--sp-5) 0;padding:var(--sp-4);border-radius:var(--r-xl);border:1px solid var(--stroke);background:var(--panel);box-shadow:var(--sh-card)}
.sim-group-head{display:flex;align-items:center;gap:var(--sp-3);margin-bottom:var(--sp-3);flex-wrap:wrap}
.sg-num{width:26px;height:26px;border-radius:50%;flex:none;display:grid;place-items:center;font-size:12px;font-weight:800;color:#fff;background:linear-gradient(135deg,var(--accent),var(--accent-2));box-shadow:0 4px 12px color-mix(in srgb,var(--accent) 40%,transparent)}
.sg-title{font-size:var(--fs-sm);font-weight:700;color:var(--txt);white-space:nowrap}
.sg-rule{flex:1;height:1px;background:var(--stroke);min-width:16px}
.sim-group .day-grid{padding:0}
.sim-group .card figcaption{opacity:1;transform:none;background:linear-gradient(transparent,rgba(0,0,0,.92));font-variant-numeric:tabular-nums}
.sim-group .card.sim-best::after{box-shadow:inset 0 0 0 2px color-mix(in srgb,var(--accent-2) 70%,transparent), var(--inset-top)}
.best-badge{position:absolute;top:var(--sp-2);left:calc(var(--sp-2) + 42px);z-index:6;font-size:9.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;padding:4px var(--sp-2);border-radius:var(--r-full);background:linear-gradient(135deg,var(--accent),var(--accent-2));color:#fff;box-shadow:0 4px 14px color-mix(in srgb,var(--accent) 50%,transparent);pointer-events:none}
@media (max-width:767px){
  .sim-bar{padding:var(--sp-2) var(--sp-3);gap:var(--sp-2)}
  .sim-sens input[type="range"]{width:90px}
  .sim-group{margin:var(--sp-4) var(--sp-3) 0;padding:var(--sp-3)}
  .sim-actions{width:100%;margin-left:0}
  .sim-actions .btn{flex:1;min-width:0}
}
</style>
</head>
<body>


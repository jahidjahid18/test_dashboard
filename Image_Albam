    toast('Limited mode: this browser has no folder picker. Use Chrome or Edge for full features.', 'err');
    $('folderChipName').textContent = 'No Folder Open';
    return;
  }

  state.savedHandles = await getSavedHandles();

  if (!state.savedHandles.length){
    $('folderChipName').textContent = 'No Folder Open';
    toast('Click Open to choose your folder');
    return;
  }

  let handle = state.savedHandles[0].handle;
  $('folderChipName').textContent = handle.name;

  let perm = 'prompt';
  try{ perm = handle.queryPermission ? await handle.queryPermission({ mode: 'readwrite' }) : 'granted'; }catch(e){}
  if (perm === 'granted'){
    state.writeGranted = true;
    updateWriteBadge();
    await loadFromHandle(handle);
    return;
  }

  state.handle = handle;
  state.writeGranted = false;
  updateWriteBadge();
  const banner = document.createElement('div');
  banner.className = 'empty';
  banner.innerHTML = `
    <div class="empty-inner">
      <div class="empty-art"><svg class="ic"><use href="#i-folder-open"/></svg></div>
      <h3>Welcome back</h3>
      <p>Your album remembers <code>${escapeHtml(handle.name)}</code>. Click below to reconnect with <b>write access</b> so delete and apply work.</p>
      <div class="empty-actions">
        <button class="btn primary" id="reconnectBtn">
          <svg class="ic"><use href="#i-folder"/></svg>
          Reconnect with write access
        </button>
      </div>
    </div>`;
  contentEl.appendChild(banner);
  banner.querySelector('#reconnectBtn').addEventListener('click', async () => {
    try{
      const p = await handle.requestPermission({ mode: 'readwrite' });
      if (p === 'granted'){
        state.writeGranted = true;
        updateWriteBadge();
        contentEl.innerHTML = '';
        await loadFromHandle(handle);
        return;
      }
    }catch(e){ console.error(e); }
    chooseFolder();
  });
}

async function chooseFolder(){
  if (!window.showDirectoryPicker){
    toast('Your browser has no folder picker — Chrome or Edge required. Opening a plain file picker instead (read-only).', 'err');
    fileInput.click();
    return;
  }
  if (location.protocol === 'file:'){
    showFileProtocolBanner();
    toast('Folder picker needs http://localhost — see banner above', 'err');
    return;
  }
  try{
    const handle = await window.showDirectoryPicker({ id: 'ahmad-album', mode: 'readwrite' });

    const existingIdx = state.savedHandles.findIndex(h => h.handle.name === handle.name);
    if (existingIdx >= 0) {
        state.savedHandles[existingIdx] = { name: handle.name, handle };
    } else {
        state.savedHandles.push({ name: handle.name, handle });
    }
    await saveSavedHandles(state.savedHandles);

    let perm = 'unknown';
    try{ if (handle.queryPermission) perm = await handle.queryPermission({ mode:'readwrite' }); }catch(e){}
    if (perm === 'granted') state.writeGranted = true;
    else {
      state.writeGranted = false;
      toast('Folder opened read-only — delete and apply won\'t work', 'err');
    }
    updateWriteBadge();
    await loadFromHandle(handle);
  }catch(err){
    if (err && err.name === 'AbortError') return;
    console.error(err);
    toast('Could not open that folder: ' + (err && err.message ? err.message : 'unknown error'), 'err');
  }
}

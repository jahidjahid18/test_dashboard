function matches(it){
  const f = state.filter;
  if (f.favOnly && !state.favorites.has(it.name)) return false;
  if (f.year  && it.y  !== f.year)  return false;
  if (f.month && it.mo !== f.month) return false;
  if (f.day   && it.d  !== f.day)   return false;
  if (f.personId != null){
    if (f.personId === -1){
      const d = state.faceData.get(it.name);
      if (!d || d.faces.length > 0) return false;
    } else {
      const set = state.itemPeople.get(it.name);
      if (!set || !set.has(f.personId)) return false;
    }
  }
  if (state.search){
    const hay = (it.name + ' ' + (it.basename || '')).toLowerCase();
    if (!hay.includes(state.search)) return false;
  }
  return true;
}
let lazyObserver = null;

function renderAll(){
  updateSimilarBtn();
  if (state.filter.similar){ renderSimilar(); return; }

  const filtered = state.items.filter(matches);
  state.view = filtered;
  statEl.textContent = compactFmt.format(filtered.length) + ' / ' + compactFmt.format(state.items.length);
  renderChips();
  updateFavBadge();
  renderPeople();
  if (lazyObserver){ lazyObserver.disconnect(); lazyObserver = null; }
  contentEl.innerHTML = '';

  const isHome = !state.filter.year && !state.filter.month && !state.filter.day
              && !state.filter.favOnly && !state.search
              && state.filter.personId == null;
  if (isHome && state.items.length){
    contentEl.appendChild(makeHero());
    const strip = makeMonthStrip();
    if (strip) contentEl.appendChild(strip);
  }
  if (!filtered.length){
    contentEl.appendChild(makeEmpty());
    renderTree();
    updateScrubber();
    return;
  }

  const days = new Map();
  for (const it of filtered){
    const key = `${it.y}-${pad(it.mo)}-${pad(it.d)}`;
    if (!days.has(key)) days.set(key, []);
    days.get(key).push(it);
  }
  for (const [key, list] of days){
    const order = state.customOrder[key];
    if (order && order.length){
      list.sort((a,b) => {
        const ia = order.indexOf(a.name), ib = order.indexOf(b.name);
        if (ia < 0 && ib < 0) return 0;
        if (ia < 0) return 1;
        if (ib < 0) return -1;
        return ia - ib;
      });
    }
  }
  const sortedKeys = [...days.keys()].sort((a,b) => b.localeCompare(a));

  lazyObserver = new IntersectionObserver((entries) => {
    for (const entry of entries){
      if (!entry.isIntersecting) continue;
      const el = entry.target;
      lazyObserver.unobserve(el);
      if (el.classList.contains('day-section')) renderNextChunk(el);
      else if (el.classList.contains('chunk-sentinel')){
        const section = el.closest('.day-section');
        el.remove();
        renderNextChunk(section);
      }
    }
  }, { rootMargin: '800px 0px' });

  const frag = document.createDocumentFragment();
  let lastMonth = null;

  for (const key of sortedKeys){
    const [ys, ms, ds] = key.split('-');
    const y = +ys, mo = +ms, d = +ds;
    const list = days.get(key);

    const mKey = y + '-' + mo;
    if (mKey !== lastMonth){
      lastMonth = mKey;
      const totalInMonth = filtered.filter(i => i.y === y && i.mo === mo).length;
      const band = document.createElement('div');
      band.className = 'month-band';
      band.dataset.monthkey = mKey;
      band.innerHTML = `<h2>${MONTHS[mo-1]} ${y}</h2><span class="mb-rule"></span><span class="mb-meta">${compactFmt.format(totalInMonth)} PHOTO${totalInMonth > 1 ? 'S' : ''}</span>`;
      frag.appendChild(band);
    }

    const section = document.createElement('figure');
    section.className = 'day-section';
    section.setAttribute('role', 'group');
    section.dataset.daykey = key;
    section._items = list;
    section._rendered = 0;

    const times = list.filter(i => i.hasTime).map(i => i.hh * 3600 + i.mi * 60 + i.ss);
    let timeTxt = '';
    if (times.length > 1){
      const lo = Math.min(...times), hi = Math.max(...times);
      const f = s => `${pad(Math.floor(s/3600))}:${pad(Math.floor(s%3600/60))}`;
      timeTxt = ` · ${f(lo)} – ${f(hi)}`;
    } else if (times.length === 1){
      const s = times[0];
      timeTxt = ` · ${pad(Math.floor(s/3600))}:${pad(Math.floor(s%3600/60))}`;
    }

    const head = document.createElement('figcaption');
    head.className = 'day-head';
    head.innerHTML = `
      <span class="dh-dot"></span>
      <span class="dh-date">${escapeHtml(fmtDay.format(new Date(y, mo-1, d)))}</span>
      <span class="dh-meta">${compactFmt.format(list.length)} photo${list.length > 1 ? 's' : ''}${timeTxt}</span>
      ${state.layout === 'grid' ? `<div class="dh-actions"><button class="dh-btn" data-act="reset-order"><svg class="ic"><use href="#i-refresh-cw"/></svg>Reset order</button></div>` : ''}`;
    section.appendChild(head);

    if (state.layout === 'grid'){
      head.querySelector('[data-act="reset-order"]').addEventListener('click', () => {
        delete state.customOrder[key];
        saveLocal('order', state.customOrder);
        renderAll();
        toast('Order reset');
      });
    }

    const grid = document.createElement('div');
    grid.className = 'day-grid layout-' + state.layout;
    section.appendChild(grid);
    frag.appendChild(section);
  }

  contentEl.appendChild(frag);
  contentEl.querySelectorAll('.day-section').forEach(s => lazyObserver.observe(s));
  renderTree();
  updateScrubber();
  refreshSelectionVisuals();
  requestAnimationFrame(applyAdjustToAll);
}

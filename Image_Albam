async function scanFaces(){
  if (state.scanning) return;
  if (!state.items.length){ toast('Load photos first', 'err'); return; }
  if (state.faceSource === 'python') toast('Python sidecar present — browser scan writes to a separate file', 'ok');
  const ok = await loadFaceModels();
  if (!ok) return;
  state.scanning = true;
  state.scanCancel = false;
  updateScanBtn();
  const todo  = state.items.filter(it => !state.faceData.has(it.name));
  const total = state.items.length;
  if (!todo.length){
    state.scanning = false;
    updateScanBtn();
    await rebuildPeople();
    toast('All photos already scanned', 'ok');
    return;
  }
  toast(`Scanning faces… 0 / ${total}`);
  let done = total - todo.length;
  let facesFound = 0;
  for (const it of todo){
    if (state.scanCancel) break;
    try{
      const data = await detectFacesOnImage(it);
      state.faceData.set(it.name, data || { w: it.w || 0, h: it.h || 0, faces: [] });
      if (data) facesFound += data.faces.length;
    }catch(e){
      console.warn('face scan failed', it.name, e);
      state.faceData.set(it.name, { w: it.w || 0, h: it.h || 0, faces: [] });
    }
    done++;
    if (done % 1000 === 0){
      await saveFaceData();
      toast(`Scanning faces… ${done} / ${total}   (checkpoint saved)`);
    } else {
      toast(`Scanning faces… ${done} / ${total}   (${facesFound} found)`);
    }
    await new Promise(r => (window.requestIdleCallback ? requestIdleCallback(r, { timeout: 60 }) : setTimeout(r, 0)));
  }
  const cancelled = state.scanCancel;
  state.scanning = false;
  state.scanCancel = false;
  updateScanBtn();
  await saveFaceData();
  try{ if (!localStorage.getItem(faceDistKey())) state.faceDist = computeDefaultFaceDist(); }catch(e){}
  updateSensitivityUI();
  await rebuildPeople();
  if (cancelled) toast(`Scan stopped — ${done}/${total} done`, 'err');
  else {
    const n = state.people.length;
    toast(`Found ${n} ${n === 1 ? 'person' : 'people'} in ${state.faceData.size} photo${state.faceData.size === 1 ? '' : 's'}`, 'ok');
  }
  renderAll();
}
async function cropFace(name, box){
  const it = state.items.find(i => i.name === name);
  if (!it) return null;
  const d = state.faceData.get(name);
  if (!d || !d.w || !d.h) return null;
  let url = it.url;
  if (!url && it.file) url = URL.createObjectURL(it.file);
  const img = await loadImageEl(url);
  if (!img || !img.naturalWidth) return null;
  const sx = img.naturalWidth  / d.w;
  const sy = img.naturalHeight / d.h;
  const realX = box.x * sx, realY = box.y * sy;
  const realW = box.width * sx, realH = box.height * sy;
  const pad = 0.45;
  const w = realW * (1 + pad * 2);
  const h = realH * (1 + pad * 2);
  const x = realX - realW * pad;
  const y = realY - realH * pad;
  const S = 96;
  const c = document.createElement('canvas');
  c.width = S; c.height = S;
  const ctx = c.getContext('2d');
  const scale = Math.max(S / w, S / h);
  try{
    ctx.drawImage(img, -x * scale, -y * scale, img.naturalWidth * scale, img.naturalHeight * scale);
    return c.toDataURL('image/jpeg', 0.82);
  }catch(e){ return null; }
}

/* ============================================================
   NEW rebuildPeople — two-stage verified clustering
   ============================================================ */
async function rebuildPeople(){
  const nameSet = new Set(state.items.map(i => i.name));
  const all = [];

  for (const [name, data] of state.faceData){
    if (!nameSet.has(name)) continue;
    for (const f of data.faces){
      if (!f.desc || !f.desc.length) continue;
      // Skip low-confidence faces from clustering (still drawn as "unknown")
      if ((f.score != null) && f.score < 0.50) continue;
      f.personId = -1;
      if (!f._normed){
        let norm = 0;
        for (let i = 0; i < f.desc.length; i++) norm += f.desc[i] * f.desc[i];
        norm = Math.sqrt(norm) || 1;
        if (Math.abs(norm - 1) > 0.01){
          const nd = new Float32Array(f.desc.length);
          for (let i = 0; i < f.desc.length; i++) nd[i] = f.desc[i] / norm;
          f.desc = nd;
        }
        f._normed = true;
      }
      all.push({ name, face: f });
    }
  }

  function dist(a, b){
    if (a.length !== b.length) return Infinity;
    let s = 0;
    for (let i = 0; i < a.length; i++){ const d = a[i] - b[i]; s += d * d; }
    return Math.sqrt(s);
  }
  function centroidOf(members){
    const dim = members[0].face.desc.length;
    const c = new Float32Array(dim);
    for (const m of members) for (let i = 0; i < dim; i++) c[i] += m.face.desc[i];
    let norm = 0;
    for (let i = 0; i < dim; i++) norm += c[i] * c[i];
    norm = Math.sqrt(norm) || 1;
    for (let i = 0; i < dim; i++) c[i] /= norm;
    return c;
  }

  const eps = state.faceDist;
  const tightEps = eps * 0.85;

  // Stage 1: tight greedy seeding
  const clusters = [];
  for (const entry of all){
    let best = null, bestDist = Infinity;
    for (const c of clusters){
      if (entry.face.desc.length !== c.centroid.length) continue;
      const d = dist(entry.face.desc, c.centroid);
      if (d < bestDist){ bestDist = d; best = c; }
    }
    if (best && bestDist < tightEps){
      best.members.push(entry);
      best.centroid = centroidOf(best.members);
    } else {
      clusters.push({
        members: [entry],
        centroid: Float32Array.from(entry.face.desc),
      });
    }
  }

  // Stage 2: verified merge using average pairwise distance
  let merged = true, safety = 30;
  while (merged && safety-- > 0){
    merged = false;
    for (let i = 0; i < clusters.length; i++){
      if (!clusters[i]) continue;
      for (let j = i + 1; j < clusters.length; j++){
        if (!clusters[j]) continue;
        if (clusters[i].centroid.length !== clusters[j].centroid.length) continue;
        const cd = dist(clusters[i].centroid, clusters[j].centroid);
        if (cd > eps * 1.10) continue;

        const A = clusters[i].members, B = clusters[j].members;
        const stepA = Math.max(1, Math.floor(A.length / 8));
        const stepB = Math.max(1, Math.floor(B.length / 8));
        let sum = 0, cnt = 0;
        for (let a = 0; a < A.length; a += stepA){
          for (let b = 0; b < B.length; b += stepB){
            sum += dist(A[a].face.desc, B[b].face.desc);
            cnt++;
          }
        }
        const avg = sum / Math.max(cnt, 1);
        if (avg < eps){
          clusters[i].members.push(...clusters[j].members);
          clusters[i].centroid = centroidOf(clusters[i].members);
          clusters[j] = null;
          merged = true;
        }
      }
    }
    for (let k = clusters.length - 1; k >= 0; k--) if (!clusters[k]) clusters.splice(k, 1);
    await new Promise(r => setTimeout(r, 0));
  }

  clusters.sort((a, b) => b.members.length - a.members.length);
  const kept = clusters.filter(c => c.members.length >= FACE_MIN_CLUSTER);

  state.people = kept.map((c, i) => {
    let cover = c.members[0];
    let coverArea = cover.face.box.width * cover.face.box.height;
    for (const m of c.members){
      const a = m.face.box.width * m.face.box.height;
      if (a > coverArea){ cover = m; coverArea = a; }
    }
    return {
      id: i,
      count: c.members.length,
      faces: c.members,
      coverName: cover.name,
      coverBox: cover.face.box,
      avatar: null,
    };
  });
  for (const p of state.people){
    for (const f of p.faces) f.face.personId = p.id;
  }

  state.itemPeople = new Map();
  for (const p of state.people){
    for (const f of p.faces){
      if (!state.itemPeople.has(f.name)) state.itemPeople.set(f.name, new Set());
      state.itemPeople.get(f.name).add(p.id);
    }
  }
  if (state.filter.personId != null && state.filter.personId !== -1 && state.filter.personId >= state.people.length){
    state.filter.personId = null;
  }

  const pending = state.people.map(p =>
    cropFace(p.coverName, p.coverBox).then(url => { p.avatar = url; })
  );
  await Promise.all(pending);
  renderPeople();
  renderTree();
}


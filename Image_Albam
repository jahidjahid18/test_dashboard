function validYMD(y, m, d){
  if (m < 1 || m > 12 || d < 1 || d > 31) return false;
  const dt = new Date(y, m - 1, d);
  return dt.getFullYear() === y && dt.getMonth() === m - 1 && dt.getDate() === d;
}
function parseMeta(file){
  const base = file.name.replace(/\.[^.]+$/, '');
  let y = null, mo = null, d = null;
  let hh = 0, mi = 0, ss = 0, hasTime = false;
  let end = 0;
  let m = /(?:^|\D)((?:19|20)\d{2})(0[1-9]|1[0-2])(0[1-9]|[12]\d|3[01])(?!\d)/.exec(base);
  if (m){ y = +m[1]; mo = +m[2]; d = +m[3]; end = m.index + m[0].length; }
  else {
    m = /(?:^|\D)((?:19|20)\d{2})[-_.\/ ](\d{1,2})[-_.\/ ](\d{1,2})(?!\d)/.exec(base);
    if (m){ y = +m[1]; mo = +m[2]; d = +m[3]; end = m.index + m[0].length; }
  }
  if (y !== null && !validYMD(y, mo, d)) { y = mo = d = null; }
  if (y !== null){
    const rest = base.slice(end);
    const t = /(?:^|\D)([01]\d|2[0-3])[-_.:]?([0-5]\d)[-_.:]?([0-5]\d)(?!\d)/.exec(rest);
    if (t){ hh = +t[1]; mi = +t[2]; ss = +t[3]; hasTime = true; }
  }
  if (y === null){
    const dt = new Date(file.lastModified || Date.now());
    y = dt.getFullYear(); mo = dt.getMonth() + 1; d = dt.getDate();
    hh = dt.getHours(); mi = dt.getMinutes(); ss = dt.getSeconds(); hasTime = true;
  }
  return { y, mo, d, hh, mi, ss, hasTime, ts: new Date(y, mo - 1, d, hh, mi, ss).getTime() };
}

function extractAmbient(url){
  return new Promise(resolve => {
    if (state.ambientCache.has(url)){ resolve(state.ambientCache.get(url)); return; }
    const img = new Image();
    img.onload = () => {
      try{
        const c = document.createElement('canvas');
        const size = 32;
        c.width = size; c.height = size;
        const ctx = c.getContext('2d', { willReadFrequently:true });
        ctx.drawImage(img, 0, 0, size, size);
        const data = ctx.getImageData(0, 0, size, size).data;
        let r=0, g=0, b=0, n=0;
        for (let i = 0; i < data.length; i += 16){
          const rr = data[i], gg = data[i+1], bb = data[i+2];
          const lum = (rr*0.299 + gg*0.587 + bb*0.114);
          if (lum < 20 || lum > 235) continue;
          r += rr; g += gg; b += bb; n++;
        }
        if (!n){ r=120; g=100; b=160; n=1; }
        r = Math.round(r/n); g = Math.round(g/n); b = Math.round(b/n);
        const avg = (r+g+b)/3, sat = 1.35;
        r = Math.max(0, Math.min(255, Math.round(avg + (r-avg)*sat)));
        g = Math.max(0, Math.min(255, Math.round(avg + (g-avg)*sat)));
        b = Math.max(0, Math.min(255, Math.round(avg + (b-avg)*sat)));
        const color = `rgb(${r},${g},${b})`;
        state.ambientCache.set(url, color);
        resolve(color);
      }catch(err){ resolve('rgb(120,100,160)'); }
    };
    img.onerror = () => resolve('rgb(120,100,160)');
    img.src = url;
  });
}

function measureImage(url){
  return new Promise(resolve => {
    const img = new Image();
    img.onload = () => resolve({ w: img.naturalWidth || 4, h: img.naturalHeight || 3 });
    img.onerror = () => resolve({ w: 4, h: 3 });
    img.src = url;
  });
}
async function measureAll(items, onProgress){
  let i = 0, done = 0;
  const total = items.length;
  async function worker(){
    while (i < items.length){
      const item = items[i++];
      if (!(item.w && item.h)){
        if (item.url){
          const dim = await measureImage(item.url);
          item.w = dim.w; item.h = dim.h;
        }
      }
      done++;
      if (onProgress && (done % 16 === 0 || done === total)) onProgress(done, total);
    }
  }
  await Promise.all(Array.from({length: 6}, worker));
  if (onProgress) onProgress(total, total);
}
function computeJustified(aspects, containerWidth, targetRowHeight, spacing, tolerance){
  const boxes = new Array(aspects.length);
  let row = [], rowAr = 0, y = 0;
  function flush(isLast){
    if (!row.length) return;
    const gaps = (row.length - 1) * spacing;
    const availW = containerWidth - gaps;
    let h = availW / rowAr;
    const maxH = targetRowHeight * (1 + tolerance);
    const minH = targetRowHeight * (1 - tolerance);
    if (h > maxH) h = maxH;
    if (h < minH) h = minH;
    if (isLast && h > targetRowHeight) h = targetRowHeight;
    let x = 0;
    for (const item of row){
      const w = item.ar * h;
      boxes[item.i] = { top: y, left: x, width: w, height: h };
      x += w + spacing;
    }
    y += h + spacing;
    row = []; rowAr = 0;
  }
  for (let i = 0; i < aspects.length; i++){
    const ar = aspects[i] || 1.33;
    row.push({ i, ar }); rowAr += ar;
    const gaps = (row.length - 1) * spacing;
    if (rowAr * targetRowHeight + gaps >= containerWidth) flush(false);
  }
  flush(true);
  return { boxes, height: Math.max(0, y - spacing) };
}


    dd.innerHTML = '';

    for (const item of state.savedHandles) {
        const btn = document.createElement('div');
        btn.className = 'folder-item' + (state.handle && state.handle.name === item.handle.name ? ' active' : '');
        btn.innerHTML = `<span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${escapeHtml(item.handle.name)}</span>`;

        const delBtn = document.createElement('button');
        delBtn.className = 'btn-del';
        delBtn.innerHTML = `<svg class="ic" width="14" height="14"><use href="#i-x"/></svg>`;
        delBtn.title = 'Forget this folder';
        delBtn.addEventListener('click', async (e) => {
            e.stopPropagation();
            state.savedHandles = state.savedHandles.filter(h => h.handle.name !== item.handle.name);
            await saveSavedHandles(state.savedHandles);
            if (state.handle && state.handle.name === item.handle.name) {
                $('forgetBtn').click();
            } else {
                renderFolderDropdown();
            }
        });

        btn.appendChild(delBtn);
        btn.addEventListener('click', async () => {
            dd.classList.remove('open');
            if (state.handle && state.handle.name === item.handle.name) return;

            let perm = 'prompt';
            try { perm = await item.handle.queryPermission({ mode: 'readwrite' }); } catch(e) {}
            if (perm === 'granted') {
                state.writeGranted = true;
                updateWriteBadge();
                await loadFromHandle(item.handle);
            } else {
                state.handle = item.handle;
                state.writeGranted = false;
                updateWriteBadge();
                toast('Click Open to grant write access', 'err');
                await loadFromHandle(item.handle);
            }
        });
        dd.appendChild(btn);
    }

    if (state.savedHandles.length) {
        const sep = document.createElement('div');
        sep.style.cssText = 'height:1px;background:var(--stroke);margin:4px 0;';
        dd.appendChild(sep);

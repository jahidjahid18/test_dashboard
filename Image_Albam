<!DOCTYPE html>
<html lang="en" data-theme="midnight">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#07080f" />
<title>Album</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet">

<script>
(function(){
  var VALID = ['midnight','daylight','warm','forest','rose','moonlight'];
  try{
    var t = localStorage.getItem('album-theme');
    if (!t || VALID.indexOf(t) < 0){
      t = (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches)
          ? 'daylight' : 'midnight';
    }
    document.documentElement.setAttribute('data-theme', t);
  }catch(e){ document.documentElement.setAttribute('data-theme','midnight'); }
})();
</script>


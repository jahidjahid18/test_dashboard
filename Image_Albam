function renderNextChunk(section){
  const items = section._items;
  const start = section._rendered || 0;
  if (start >= items.length) return;
  const end = Math.min(start + CHUNK, items.length);
  const slice = items.slice(start, end);
  const grid = section.querySelector('.day-grid');
  renderChunkInto(grid, slice, state.layout);
  section._rendered = end;
  if (end < items.length){
    const sentinel = document.createElement('div');
    sentinel.className = 'chunk-sentinel';
    section.appendChild(sentinel);
    lazyObserver.observe(sentinel);
  } else if (state.layout === 'grid'){
    enableDragReorder(section);
  }
  applyAdjustToAll();
}
function renderChunkInto(grid, items, mode){
  if (mode === 'justified'){
    const width = grid.clientWidth || grid.offsetWidth || 800;
    const aspects = items.map(it => (it.w && it.h) ? it.w / it.h : 1.33);
    const { boxes, height } = computeJustified(aspects, width, 240, 8, 0.35);
    const wrap = document.createElement('div');
    wrap.className = 'justified-chunk';
    wrap.style.height = height + 'px';
    items.forEach((it, i) => {
      const card = makeCard(it, mode);
      const b = boxes[i];
      card.style.position = 'absolute';
      card.style.top = b.top + 'px';
      card.style.left = b.left + 'px';
      card.style.width = b.width + 'px';
      card.style.height = b.height + 'px';
      wrap.appendChild(card);
    });
    grid.appendChild(wrap);
  } else {
    items.forEach(it => grid.appendChild(makeCard(it, mode)));
  }
}
function makeCard(it, mode){
  const fig = document.createElement('figure');
  fig.className = 'card';
  fig.dataset.name = it.name;
  fig.title = displayTitle(it);

  const img = document.createElement('img');
  img.loading = 'lazy'; img.decoding = 'async';
  img.alt = it.name.replace(/\.[^.]+$/, '').replace(/[_-]+/g, ' ');

  if (it.url){
    img.src = it.url;
  }

  img.addEventListener('load',  () => img.classList.add('loaded'), { once:true });
  img.addEventListener('error', () => { fig.style.display = 'none'; }, { once:true });

  const cap = document.createElement('figcaption');
  cap.textContent = displayLabel(it);

  const badge = document.createElement('span');
  badge.className = 'badge-time';
  badge.textContent = it.hasTime ? `${pad(it.hh)}:${pad(it.mi)}` : '';

  const fav = document.createElement('button');
  fav.className = 'fav-btn' + (state.favorites.has(it.name) ? ' on' : '');
  fav.innerHTML = `<svg class="ic"><use href="#i-heart"/></svg>`;
  fav.title = 'Toggle favorite';
  fav.addEventListener('click', e => {
    e.stopPropagation();
    toggleFavorite(it.name, fav);
  });

  const del = document.createElement('button');
  del.className = 'delete-btn';
  del.innerHTML = `<svg class="ic"><use href="#i-x"/></svg>`;
  del.title = 'Delete photo';
  del.addEventListener('click', e => {
    e.stopPropagation();
    deleteImage(it, fig);
  });

  fig.append(img, fav, del, badge, cap);

  const f = buildFilter(state.adjust[it.name]);
  if (f){ img.style.filter = f; img.classList.add('adjusted'); }

  fig.addEventListener('click', (e) => {
    const mod = e.ctrlKey || e.metaKey;
    const shift = e.shiftKey;
    const inSelectMode = state.selectMode || mod || shift || state.selection.size > 0;
    if (!inSelectMode){
      openLightbox(state.view.indexOf(it), fig);
      return;
    }
    if (shift){
      if (state.lastAnchor) selectRange(state.lastAnchor, it.name);
      else toggleSelect(it.name);
      return;
    }
    toggleSelect(it.name);
  });

  if (state.selection.has(it.name)) fig.classList.add('selected');

  if (mode === 'grid'){
    const handle = document.createElement('div');
    handle.className = 'drag-handle';
    handle.innerHTML = `<svg class="ic" width="14" height="14"><use href="#i-more"/></svg>`;
    fig.appendChild(handle);
  }

    if (p !== 'granted'){ toast('Write permission denied', 'err'); return; }
    state.writeGranted = true;
    updateWriteBadge();
  }

  jobProgress.show('Applying to files…', `0 / ${targets.length}`);
  let done = 0, failed = 0;
  for (const name of targets){
    const it = state.items.find(x => x.name === name);

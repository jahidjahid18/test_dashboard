}
function makeSimGroup(group, index){
  const best = pickBestSim(group);
  const sec = document.createElement('section');
  sec.className = 'sim-group';
  const head = document.createElement('div');
  head.className = 'sim-group-head';
  head.innerHTML = `
    <span class="sg-num">${index + 1}</span>
    <span class="sg-title">${group.length} similar photos</span>
    <span class="sg-rule"></span>
    <button class="dh-btn" data-act="sel-extra"><svg class="ic"><use href="#i-check-square"/></svg>Select all but best</button>
    <button class="dh-btn" data-act="sel-none"><svg class="ic"><use href="#i-x"/></svg>Clear</button>`;
  sec.appendChild(head);
  const grid = document.createElement('div');
  grid.className = 'day-grid layout-grid';
  for (const it of group){
    const card = makeCard(it, 'sim');
    if (it === best){
      const b = document.createElement('span');
      b.className = 'best-badge';
      b.textContent = 'Best';
      card.appendChild(b);
      card.classList.add('sim-best');
    }
    const cap = card.querySelector('figcaption');
    if (cap){
      const px = (it.w && it.h) ? `${it.w}×${it.h}` : '';
      const bytes = it.file ? fmtBytes(it.file.size) : '';
      cap.textContent = [px, bytes].filter(Boolean).join('  ·  ');
    }
    grid.appendChild(card);
  }
  sec.appendChild(grid);
  head.querySelector('[data-act="sel-extra"]').addEventListener('click', () => {
    for (const it of group) if (it !== best) state.selection.add(it.name);
    state.selection.delete(best.name);
    refreshSelectionVisuals();
    updateSelectionBar();
  });
  head.querySelector('[data-act="sel-none"]').addEventListener('click', () => {
    for (const it of group) state.selection.delete(it.name);
    refreshSelectionVisuals();
    updateSelectionBar();
  });
  return sec;
}
function simAutoSelect(){
  state.selection.clear();
  for (const g of state.simGroups){
    const best = pickBestSim(g);
    for (const it of g) if (it !== best) state.selection.add(it.name);
  }
  refreshSelectionVisuals();
  updateSelectionBar();
  const n = state.selection.size;
  toast(n ? `${n} extra cop${n === 1 ? 'y' : 'ies'} selected` : 'Nothing to select', n ? 'ok' : undefined);
}
function renderSimilar(){
  if (lazyObserver){ lazyObserver.disconnect(); lazyObserver = null; }
  const sc = $('scrubber'); if (sc) sc.classList.remove('visible');
  contentEl.innerHTML = '';
  chipsEl.innerHTML = '';
  if (state.simBusy){
    statEl.textContent = 'Analyzing…';
    contentEl.innerHTML = `<div class="empty"><div class="empty-inner">
      <div class="empty-art"><svg class="ic"><use href="#i-similar"/></svg></div>
      <h3>Analyzing photos…</h3>
      <p>Building a visual fingerprint for every image so near-duplicates can be grouped.</p>
    </div></div>`;
    return;
  }
  pruneSimGroups();
  const groups = state.simGroups;
  state.view = groups.flat();
  const total = state.view.length;
  statEl.textContent = compactFmt.format(groups.length) + ' groups · ' + compactFmt.format(total) + ' photos';
  renderChips();
  const bar = document.createElement('div');
  bar.className = 'sim-bar';
  bar.innerHTML = `
    <div class="sim-count"></div>
    <div class="sim-sens">
      <span>Match</span>
      <input type="range" id="simSlider" min="0" max="20" step="1" value="${state.simThreshold}">
      <span class="val" id="simSensVal">${state.simThreshold}</span>
    </div>
    <div class="sim-actions">
      <button class="btn" data-act="auto"><svg class="ic"><use href="#i-check-square"/></svg>Auto-select extras</button>
      <button class="btn danger" data-act="del"><svg class="ic"><use href="#i-trash"/></svg>Delete selected</button>
      <button class="btn" data-act="close">Done</button>
    </div>`;
  contentEl.appendChild(bar);
  bar.querySelector('[data-act="auto"]').addEventListener('click', simAutoSelect);
  bar.querySelector('[data-act="del"]').addEventListener('click', () => {
    if (!state.selection.size){ toast('Nothing selected yet', 'err'); return; }
    batchDelete([...state.selection]);
  });
  bar.querySelector('[data-act="close"]').addEventListener('click', () => toggleSimilarMode());
  const slider = bar.querySelector('#simSlider');
  const valEl  = bar.querySelector('#simSensVal');
  slider.addEventListener('input', () => { valEl.textContent = slider.value; });
  slider.addEventListener('change', async () => {
    state.simThreshold = parseInt(slider.value, 10);
    try{ localStorage.setItem(SIM_KEY, String(state.simThreshold)); }catch(e){}
    state.simBusy = true;
    renderSimilar();
    await rebuildSimGroups();
    state.simBusy = false;
    renderSimilar();
  });
  updateSimBar();
  if (!groups.length){
    const empty = document.createElement('div');
    empty.className = 'empty';
    empty.innerHTML = `<div class="empty-inner">
      <div class="empty-art"><svg class="ic"><use href="#i-similar"/></svg></div>
      <h3>No similar photos found</h3>
      <p>Every analyzed photo looks unique at this match level. Drag the <b>Match</b> slider to the right to loosen the comparison.</p>
    </div>`;
    contentEl.appendChild(empty);
    return;
  }
  const frag = document.createDocumentFragment();
  groups.forEach((g, gi) => frag.appendChild(makeSimGroup(g, gi)));
  contentEl.appendChild(frag);
  refreshSelectionVisuals();
  requestAnimationFrame(applyAdjustToAll);
}

const marqueeEl = document.createElement('div');
marqueeEl.className = 'marquee-box';
document.body.appendChild(marqueeEl);
let marquee = null;
let marqueeLoop = null;
function marqueeRect(){
  const curY = marquee.yClient + mainEl.scrollTop;
  return {
    left: Math.min(marquee.startX, marquee.xClient),
    top: Math.min(marquee.startY, curY),
    right: Math.max(marquee.startX, marquee.xClient),
    bottom: Math.max(marquee.startY, curY)
  };
}
function paintMarqueeBox(){
  const r  = marqueeRect();
  const st = mainEl.scrollTop;
  marqueeEl.style.left   = r.left + 'px';
  marqueeEl.style.top    = (r.top - st) + 'px';
  marqueeEl.style.width  = (r.right - r.left) + 'px';
  marqueeEl.style.height = (r.bottom - r.top) + 'px';
}
function applyMarquee(){
  const r  = marqueeRect();
  const st = mainEl.scrollTop;
  const cards = contentEl.querySelectorAll('.card');
  const toAdd = [], toDel = [];
  for (const card of cards){
    const cr = card.getBoundingClientRect();
    const cardTop    = cr.top + st;
    const cardBottom = cr.bottom + st;
    const hit = !(cr.right < r.left || cr.left > r.right || cardBottom < r.top || cardTop > r.bottom);
    const name = card.dataset.name;
    const want = hit || marquee.base.has(name);
    const has  = state.selection.has(name);
    if (want && !has) toAdd.push([card, name]);
    else if (!want && has) toDel.push([card, name]);
  }
  for (const [c, n] of toAdd){ state.selection.add(n); c.classList.add('selected'); }
  for (const [c, n] of toDel){ state.selection.delete(n); c.classList.remove('selected'); }
  updateSelectionBar();
}
function marqueeTick(){
  if (!marquee){ marqueeLoop = null; return; }
  if (!marquee.moved){
    if (Math.abs(marquee.xClient - marquee.startX) >= 5 || Math.abs(marquee.yClient - marquee.startYClient) >= 5){
      marquee.moved = true;
      marqueeEl.classList.add('on');
    }
  }
  if (marquee.moved){
    const rect = mainEl.getBoundingClientRect();
    const topEdge    = rect.top + toolbarEl.offsetHeight;
    const bottomEdge = rect.bottom;
    const margin = 72, maxSpeed = 26;
    let dy = 0;
    if (marquee.yClient < topEdge + margin){
      dy = -maxSpeed * Math.min(1, (topEdge + margin - marquee.yClient) / margin);
    } else if (marquee.yClient > bottomEdge - margin){
      dy = maxSpeed * Math.min(1, (marquee.yClient - (bottomEdge - margin)) / margin);
    }
    if (dy) mainEl.scrollTop += dy;
    paintMarqueeBox();
    applyMarquee();
  }
  marqueeLoop = requestAnimationFrame(marqueeTick);
}
function onMarqueeMove(e){
  if (!marquee) return;
  marquee.xClient = e.clientX;
  marquee.yClient = e.clientY;
}
function endMarquee(){
  document.removeEventListener('mousemove', onMarqueeMove, true);
  document.removeEventListener('mouseup', onMarqueeUp, true);
  document.body.classList.remove('marquee-active');
  marqueeEl.classList.remove('on');
}
function onMarqueeUp(){
  const m = marquee;
  marquee = null;
  endMarquee();
  if (marqueeLoop){ cancelAnimationFrame(marqueeLoop); marqueeLoop = null; }
  if (!m) return;
  if (!m.moved){
    if (!m.additive) clearSelection();
    return;
  }
  state.lastAnchor = null;
  refreshSelectionVisuals();
  updateSelectionBar();
}
function startMarquee(e){
  const additive = !!(e.ctrlKey || e.metaKey || state.selectMode);
  marquee = {
    startX:       e.clientX,
    startYClient: e.clientY,
    startY:       e.clientY + mainEl.scrollTop,
    xClient:      e.clientX,
    yClient:      e.clientY,
    base:         additive ? new Set(state.selection) : new Set(),
    additive,
    moved: false
  };
  e.preventDefault();
  document.body.classList.add('marquee-active');
  document.addEventListener('mousemove', onMarqueeMove, true);
  document.addEventListener('mouseup', onMarqueeUp, true);
  if (!marqueeLoop) marqueeLoop = requestAnimationFrame(marqueeTick);
}
contentEl.addEventListener('mousedown', e => {
  if (e.button !== 0) return;
  if (marquee) return;
  if (lightbox.classList.contains('open')) return;
  if (busyBackdrop.classList.contains('open')) return;
  if (helpBackdrop.classList.contains('open')) return;
  if (adjustPanel.classList.contains('open')) return;
  if (e.target.closest('.card')) return;
  if (e.target.closest('button, a, input, select, textarea, label')) return;
  startMarquee(e);
});
document.addEventListener('keydown', e => {
  if (e.key === 'Escape' && marquee){
    const m = marquee;
    marquee = null;
    endMarquee();
    if (marqueeLoop){ cancelAnimationFrame(marqueeLoop); marqueeLoop = null; }
    if (m && m.moved){
      state.selection = new Set(m.base);
      refreshSelectionVisuals();
    }
  }
});
window.addEventListener('blur', () => {
  if (marquee){
    const m = marquee;
    marquee = null;
    endMarquee();
    if (marqueeLoop){ cancelAnimationFrame(marqueeLoop); marqueeLoop = null; }
    state.selection = new Set(m.base);
    refreshSelectionVisuals();
  }
});

try{
  const v = parseInt(localStorage.getItem(SIM_KEY) || '', 10);
  if (isFinite(v) && v >= 0 && v <= 20) state.simThreshold = v;
}catch(e){}

$('similarBtn').addEventListener('click', toggleSimilarMode);
updateSimilarBtn();

boot();

    for (const [name, d] of Object.entries(obj.items || {})){
      state.faceData.set(name, {
        w: d.w, h: d.h,
        faces: (d.faces || []).map(f => ({
          box: f.box,
          desc: f.desc instanceof Float32Array ? f.desc : Float32Array.from(f.desc),
          score: typeof f.score === 'number' ? f.score : 1.0,

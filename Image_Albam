.layout-justified .card{margin:0;position:absolute;border-radius:var(--r-md)}
.layout-justified .card img{width:100%;height:100%;object-fit:cover}
.card figcaption{position:absolute;left:0;right:0;bottom:0;z-index:3;padding:var(--sp-5) var(--sp-3) var(--sp-3);font-size:11.5px;font-weight:600;color:#fff;background:linear-gradient(transparent,rgba(0,0,0,.9));opacity:0;transform:translateY(8px);transition:opacity var(--dur-med) var(--ease-out), transform var(--dur-med) var(--ease-out);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}

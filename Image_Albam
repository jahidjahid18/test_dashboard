<div class="app" id="app">
  <aside class="sidebar" id="sidebar">
    <div class="side-head">
      <div class="brand">
        <div class="logo"><svg class="ic" width="20" height="20"><use href="#i-logo"/></svg></div>
        <div class="brand-text">
          <div class="brand-title" id="brandTitle">Album</div>
        </div>
      </div>
      <button class="icon-btn" id="helpBtn" title="Quick start guide">
        <svg class="ic" width="15" height="15"><use href="#i-help"/></svg>
      </button>
      <button class="icon-btn side-collapse" id="collapseBtn" title="Collapse sidebar (Ctrl+B)">
        <svg class="ic" width="14" height="14"><use href="#i-chevron-left"/></svg>
      </button>
    </div>

    <div class="folder-wrap">
      <button class="folder-chip" id="folderChip" title="Click to switch or add folders">
        <svg class="ic" width="14" height="14"><use href="#i-folder"/></svg>
        <span class="nm" id="folderChipName">No Folder Open</span>
        <svg class="ic" width="14" height="14"><use href="#i-chevron-down"/></svg>
      </button>
      <div class="folder-dropdown" id="folderDropdown"></div>
    </div>

    <div class="write-badge warn" id="writeBadge" style="display:none">
      <svg class="ic"><use href="#i-alert"/></svg>
      <span id="writeBadgeText">Write access not granted</span>
    </div>

    <div class="side-actions">
      <button class="mini-btn" id="changeBtn" data-tip="Open a folder">
        <svg class="ic"><use href="#i-folder"/></svg>
        <span class="txt">Open</span>
      </button>
      <button class="mini-btn" id="addFolderBtn" data-tip="Add another folder to the list">
        <svg class="ic"><use href="#i-folder"/><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2"/></svg>
        <span class="txt">Add</span>
      </button>
      <button class="mini-btn" id="refreshBtn" data-tip="Refresh">
        <svg class="ic"><use href="#i-refresh-cw"/></svg>
        <span class="txt">Refresh</span>
      </button>
      <button class="mini-btn danger" id="forgetBtn" data-tip="Forget current folder">
        <svg class="ic"><use href="#i-trash"/></svg>
        <span class="txt">Forget</span>
      </button>
    </div>

    <div class="side-sec collapsible" data-section="theme">
      <div class="side-label collapsible-header" data-toggle="theme" role="button" tabindex="0">
        <svg class="ic sc-caret" width="12" height="12"><use href="#i-chevron-right"/></svg>
        <span class="sc-text">Theme</span>
      </div>
      <div class="side-body"><div class="side-body-inner">
        <div class="theme-picker" id="themePicker">
          <button class="swatch" data-theme="midnight" title="Midnight"></button>
          <button class="swatch" data-theme="daylight" title="Daylight"></button>
          <button class="swatch" data-theme="warm" title="Warm"></button>
          <button class="swatch" data-theme="forest" title="Forest"></button>
          <button class="swatch" data-theme="rose" title="Rose"></button>
          <button class="swatch" data-theme="moonlight" title="Moonlight"></button>
        </div>
      </div></div>
    </div>

    <div class="side-sec collapsible" data-section="layout">
      <div class="side-label collapsible-header" data-toggle="layout" role="button" tabindex="0">
        <svg class="ic sc-caret" width="12" height="12"><use href="#i-chevron-right"/></svg>
        <span class="sc-text">Layout</span>
      </div>
      <div class="side-body"><div class="side-body-inner">
        <div class="layout-picker" id="layoutPicker">
          <button class="layout-btn active" data-layout="masonry" title="Masonry">
            <svg class="ic"><use href="#i-layout-masonry"/></svg><span class="txt">Masonry</span>
          </button>
          <button class="layout-btn" data-layout="justified" title="Justified">
            <svg class="ic"><use href="#i-layout-justified"/></svg><span class="txt">Justified</span>
          </button>
          <button class="layout-btn" data-layout="grid" title="Grid">
            <svg class="ic"><use href="#i-layout-grid"/></svg><span class="txt">Grid</span>
          </button>
        </div>
      </div></div>
    </div>

    <div class="side-sec collapsible" data-section="people">
      <div class="side-label no-rule collapsible-header" data-toggle="people" role="button" tabindex="0">
        <svg class="ic sc-caret" width="12" height="12"><use href="#i-chevron-right"/></svg>
        <span class="sc-text">People</span>
        <button class="label-btn" id="scanFacesBtn" title="Scan faces in browser (fallback)">
          <svg class="ic"><use href="#i-scan-face"/></svg>
        </button>
      </div>
      <div class="side-body"><div class="side-body-inner">
        <div class="people-source" id="peopleSource" style="display:none"></div>
        <div class="people-sensitivity" id="peopleSensitivity" style="display:none">
          <div class="ps-head">
            <span>Match sensitivity</span>
            <span class="ps-val" id="psValue">0.60</span>
          </div>
          <div class="ps-row">
            <button class="ps-step" id="psDown" type="button" aria-label="Decrease sensitivity" title="−0.01 (hold to repeat)">
              <svg class="ic"><use href="#i-chevron-left"/></svg>
            </button>
            <input type="range" id="psSlider" min="0.30" max="2.00" step="0.01" value="0.60">
            <button class="ps-step" id="psUp" type="button" aria-label="Increase sensitivity" title="+0.01 (hold to repeat)">
              <svg class="ic"><use href="#i-chevron-right"/></svg>
            </button>
          </div>
        </div>
        <div class="people-list" id="peopleList"></div>
      </div></div>
    </div>

    <div class="side-sec collapsible tree-section" data-section="timeline">
      <div class="side-label collapsible-header" data-toggle="timeline" role="button" tabindex="0">
        <svg class="ic sc-caret" width="12" height="12"><use href="#i-chevron-right"/></svg>
        <span class="sc-text">Timeline</span>
      </div>
      <div class="side-body"><div class="side-body-inner tree-scroll">
        <div id="treeBody"></div>
      </div></div>
    </div>
  </aside>

  <main class="main" id="main">
    <div class="toolbar" id="toolbar">
      <button class="tb-icon-btn" id="sidebarToggleBtn" title="Toggle sidebar (Ctrl+B)">
        <svg class="ic"><use href="#i-panel-left"/></svg>
      </button>
      <div class="search-wrap">
        <svg class="ic si"><use href="#i-search"/></svg>
        <input class="search" id="search" type="search" placeholder="Search photos…" autocomplete="off">
      </div>
      <div class="chips" id="chips"></div>
      <div class="tool-right">
        <div class="stat" id="stat"></div>
        <button class="mini-btn" id="similarBtn" data-tip="Find similar photos" data-tip-pos="bottom" style="flex:none">
          <svg class="ic"><use href="#i-similar"/></svg>
          <span class="lbl">Similar</span>
        </button>
        <button class="mini-btn" id="selectModeBtn" data-tip="Select multiple photos" data-tip-pos="bottom" style="flex:none">
          <svg class="ic"><use href="#i-check-square"/></svg>
          <span class="lbl">Select</span>
        </button>
        <div class="seg">
          <button id="shuffleBtn" data-tip="Shuffle" data-tip-pos="bottom">
            <svg class="ic"><use href="#i-shuffle"/></svg><span class="lbl">Shuffle</span>
          </button>
          <button id="exportBtn" data-tip="Export as ZIP" data-tip-pos="bottom">
            <svg class="ic"><use href="#i-download"/></svg><span class="lbl">Export</span>
          </button>
        </div>
      </div>
    </div>
    <div class="progress"><i id="progressBar"></i></div>
    <div id="content"></div>
  </main>
</div>

<div class="scrubber" id="scrubber" aria-hidden="true">
  <div class="scrubber-track" id="scrubberTrack">
    <div class="scrubber-thumb" id="scrubberThumb" style="top:0"></div>
  </div>
</div>

<nav class="bottom-nav" id="bottomNav" role="navigation">
  <button data-sheet="timeline" aria-label="Timeline"><svg class="ic"><use href="#i-clock"/></svg>Timeline</button>
  <button data-sheet="favorites" aria-label="Favorites"><svg class="ic"><use href="#i-heart"/></svg>Favorites<span class="bn-badge" id="favBadge" style="display:none"></span></button>
  <button data-sheet="people" aria-label="People"><svg class="ic"><use href="#i-users"/></svg>People</button>
  <button data-sheet="layout" aria-label="Layout"><svg class="ic"><use href="#i-layout-grid"/></svg>Layout</button>
  <button data-sheet="theme" aria-label="Theme"><svg class="ic"><use href="#i-droplet"/></svg>Theme</button>
</nav>

<div class="sheet-backdrop" id="sheetBackdrop"></div>
<div class="bottom-sheet" id="bottomSheet" role="dialog" aria-modal="true">
  <div class="sheet-handle" id="sheetHandle"></div>
  <div class="sheet-head">
    <h3 id="sheetTitle">Timeline</h3>
    <button class="sheet-close" id="sheetClose" aria-label="Close"><svg class="ic"><use href="#i-x"/></svg></button>
  </div>
  <div class="sheet-body" id="sheetBody"></div>
</div>

<div class="lightbox" id="lightbox">
  <div class="ambient" id="ambient"></div>
  <div class="lb-stage" id="lbStage">
    <div class="lb-track" id="lbTrack">
      <div class="lb-imgwrap" id="lbImgWrap">
        <img id="lbImg" alt="" draggable="false">
        <div class="lb-faces" id="lbFaces"></div>
      </div>
    </div>
    <button class="lb-close" id="lbClose" aria-label="Close"><svg class="ic"><use href="#i-x"/></svg></button>
    <div class="lb-top-actions">
      <button class="lb-icon-btn" id="lbAdjust" title="Adjust color & light (A)">
        <svg class="ic"><use href="#i-sliders"/></svg>
      </button>
      <button class="lb-icon-btn" id="lbFav" title="Favorite (F)"><svg class="ic"><use href="#i-heart"/></svg></button>
      <button class="lb-icon-btn" id="lbInfo" title="EXIF info (I)"><svg class="ic"><use href="#i-info"/></svg></button>
      <button class="lb-icon-btn" id="lbCover" title="Set as album cover"><svg class="ic"><use href="#i-image"/></svg></button>
    </div>
    <button class="lb-nav prev" id="lbPrev" aria-label="Previous"><svg class="ic"><use href="#i-chevron-left"/></svg></button>
    <button class="lb-nav next" id="lbNext" aria-label="Next"><svg class="ic"><use href="#i-chevron-right"/></svg></button>
    <div class="lb-caption" id="lbCaption"></div>
    <div class="lb-hint" id="lbHint">Swipe to navigate · Swipe down to close</div>
  </div>
  <aside class="exif-panel" id="exifPanel">
    <div class="exif-head">
      <h3>Photo details</h3>
      <button class="exif-close" id="exifClose" aria-label="Close"><svg class="ic"><use href="#i-x"/></svg></button>
    </div>
    <div class="exif-body" id="exifBody">
      <div class="exif-loading"><div class="spin"></div><div>Reading metadata…</div></div>
    </div>
  </aside>
</div>

<aside class="adjust-panel" id="adjustPanel" role="dialog" aria-label="Adjust color and light">
  <div class="ap-head">
    <h3 id="apTitle">Adjust</h3>
    <button class="exif-close" id="apClose" aria-label="Close"><svg class="ic"><use href="#i-x"/></svg></button>
  </div>
  <div class="ap-body">
    <p class="ap-hint" id="apHint"></p>
    <div class="ap-row">
      <label>Exposure <span class="ap-val" data-val="b">0</span></label>
      <input type="range" data-slider="b" min="-100" max="100" step="1" value="0">
    </div>
    <div class="ap-row">
      <label>Contrast <span class="ap-val" data-val="c">0</span></label>
      <input type="range" data-slider="c" min="-100" max="100" step="1" value="0">
    </div>
    <div class="ap-row">
      <label>Saturation <span class="ap-val" data-val="s">0</span></label>
      <input type="range" data-slider="s" min="-100" max="100" step="1" value="0">

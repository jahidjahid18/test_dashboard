.card::before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,var(--skel-a) 25%,var(--skel-b) 50%,var(--skel-a) 75%);background-size:200% 100%;animation:shimmer 1.6s ease-in-out infinite;opacity:1;transition:opacity var(--dur-med) ease;pointer-events:none}
@keyframes shimmer{from{background-position:200% 0}to{background-position:-200% 0}}
.card:has(img.loaded)::before{opacity:0}
.card img{display:block;width:100%;height:auto;position:relative;z-index:2;opacity:0;transform:scale(1.03);transition:opacity .55s ease,transform .55s var(--ease-out);-webkit-user-drag:none}

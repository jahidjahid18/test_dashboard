async function getSourceFile(name){
  const parts = name.split('/').filter(Boolean);
  const filename = parts.pop();
  let dir = state.handle;
  for (const part of parts){ dir = await dir.getDirectoryHandle(part); }
  const fh = await dir.getFileHandle(filename);
  return fh.getFile();
}
async function copyOrMoveSelected(names, mode){
  if (!window.showDirectoryPicker){ toast('Chrome or Edge required', 'err'); return; }
  if (!state.handle){ toast('Load a folder first', 'err'); return; }
  if (location.protocol === 'file:'){ showFileProtocolBanner(); toast('Destination picker needs http://localhost', 'err'); return; }

  let destHandle;
  try{
    destHandle = await window.showDirectoryPicker({ id: 'ahmad-album-dest', mode: 'readwrite' });
  }catch(err){
    if (err && err.name === 'AbortError') return;
    toast('Could not open destination: ' + (err && err.message ? err.message : 'unknown'), 'err');
    return;
  }
  try{
    if (await state.handle.isSameEntry(destHandle)){
      toast('Destination must be a different folder', 'err');
      return;
    }
  }catch(e){}
  let destPerm = 'unknown';
  try{
    if (destHandle.queryPermission) destPerm = await destHandle.queryPermission({ mode: 'readwrite' });
    if (destPerm !== 'granted' && destHandle.requestPermission){
      destPerm = await destHandle.requestPermission({ mode: 'readwrite' });
    }
  }catch(e){}
  if (destPerm !== 'granted'){ toast('Destination is read-only', 'err'); return; }

  if (mode === 'move'){
    try{
      let p = 'unknown';
      if (state.handle.queryPermission) p = await state.handle.queryPermission({ mode: 'readwrite' });
      if (p !== 'granted' && state.handle.requestPermission) p = await state.handle.requestPermission({ mode: 'readwrite' });
      if (p !== 'granted'){ toast('Source is read-only — move needs write access', 'err'); return; }
    }catch(e){ toast('Could not verify source write access', 'err'); return; }
  }

  const total = names.length;
  const succeeded = [];
  let fail = 0;
  let firstError = null;

  jobProgress.show(mode === 'move' ? 'Moving photos…' : 'Copying photos…', `0 / ${total}`);

  for (let i = 0; i < names.length; i++){
    const name = names[i];
    try{
      const file = await getSourceFile(name);
      if (!file) throw new Error('source unavailable');
      const basename = name.split('/').pop();
      const destFile = await destHandle.getFileHandle(basename, { create: true });
      const writable = await destFile.createWritable();
      await writable.write(file);
      await writable.close();
      if (mode === 'move') await deleteFileByRelPath(name);
      succeeded.push(name);
    }catch(err){
      console.warn(mode + ' failed for', name, err);
      if (!firstError) firstError = err.message || String(err);
      fail++;
    }
    const pct = ((i + 1) / total) * 100;
    jobProgress.update(
      mode === 'move' ? 'Moving photos…' : 'Copying photos…',
      `${i + 1} / ${total}   (${succeeded.length} ok, ${fail} failed)`,
      pct
    );
  }

  jobProgress.update(mode === 'move' ? 'Move complete' : 'Copy complete', `${succeeded.length} ok, ${fail} failed`, 100);
  setTimeout(() => jobProgress.hide(), 900);

  if (mode === 'move' && succeeded.length){
    const set = new Set(succeeded);
    state.items = state.items.filter(it => {
      if (set.has(it.name)){
        try{ if(it.url) URL.revokeObjectURL(it.url); }catch(e){}
        it.url = null;
        state.favorites.delete(it.name);
        state.faceData.delete(it.name);
        state.hashes.delete(it.name);
        return false;
      }
      return true;
    });
    saveLocal('favs', [...state.favorites]);
    removeFromCustomOrder(succeeded);
    removeFromAdjust(succeeded);
    state.selection.clear();
    state.lastAnchor = null;
    updateSelectionBar();
    renderAll();
  } else clearSelection();

  if (fail === 0) toast(`${succeeded.length} ${mode === 'move' ? 'moved' : 'copied'}`, 'ok');
  else if (succeeded.length === 0) toast(`${mode === 'move' ? 'Move' : 'Copy'} failed: ${firstError || 'unknown'}`, 'err');
  else toast(`${succeeded.length} ${mode === 'move' ? 'moved' : 'copied'}, ${fail} failed`, 'err');
}


async function loadExif(){
  const it = state.view[state.lbIndex];
  if (!it) return;
  if (typeof exifr === 'undefined'){ exifBody.innerHTML = '<div class="exif-loading">EXIF library not loaded.</div>'; return; }
  if (state.exifCache.has(it.name)){ renderExif(state.exifCache.get(it.name)); return; }
  exifBody.innerHTML = '<div class="exif-loading"><div class="spin"></div><div>Reading metadata…</div></div>';

  let url = it.url;
  if (!url && it.file) url = URL.createObjectURL(it.file);

  try{
    const data = await exifr.parse(url, [
      'Make','Model','LensModel','FNumber','ExposureTime','ISO','FocalLength',
      'FocalLengthIn35mmFormat','DateTimeOriginal','CreateDate',
      'GPSLatitude','GPSLongitude','GPSAltitude','Orientation','Software'
    ]);
    state.exifCache.set(it.name, data || {});
    renderExif(data || {});
  }catch(err){
    exifBody.innerHTML = '<div class="exif-loading">No EXIF data found for this image.</div>';
  }
}
function renderExif(d){
  if (!d || !Object.keys(d).length){
    exifBody.innerHTML = '<div class="exif-loading">No EXIF data found.</div>';
    return;
  }
  const rows = [];
  const add = (k, v) => { if (v !== undefined && v !== null && v !== '') rows.push([k, v]); };
  add('Camera',  [d.Make, d.Model].filter(Boolean).join(' '));
  add('Lens',    d.LensModel);
  add('Focal length', d.FocalLength ? `${d.FocalLength}mm${d.FocalLengthIn35mmFormat ? ` (${d.FocalLengthIn35mmFormat}mm eq.)` : ''}` : '');
  add('Aperture', d.FNumber ? `f/${d.FNumber}` : '');
  if (d.ExposureTime){
    const et = d.ExposureTime;
    add('Shutter', et < 1 ? `1/${Math.round(1/et)}s` : `${et}s`);
  }
  add('ISO', d.ISO);
  const dt = d.DateTimeOriginal || d.CreateDate;
  if (dt) add('Taken', dt instanceof Date ? dt.toLocaleString() : String(dt));
  add('Software', d.Software);
  add('Orientation', d.Orientation);
  let html = rows.map(([k,v]) =>
    `<div class="exif-row"><span class="exif-key">${escapeHtml(k)}</span><span class="exif-val">${escapeHtml(String(v))}</span></div>`
  ).join('');
  if (d.GPSLatitude !== undefined && d.GPSLongitude !== undefined){
    const lat = d.GPSLatitude, lon = d.GPSLongitude;
    const link = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=15/${lat}/${lon}`;
    html += `<div class="exif-row exif-gps"><span class="exif-key">Location</span><span class="exif-val"><a href="${link}" target="_blank" rel="noopener">${lat.toFixed(5)}, ${lon.toFixed(5)}</a></span></div>`;
  }
  exifBody.innerHTML = html || '<div class="exif-loading">No useful EXIF fields found.</div>';
}


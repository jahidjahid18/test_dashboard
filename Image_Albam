const FACE_MODEL_URL   = 'https://cdn.jsdelivr.net/npm/@vladmandic/face-api/model';
const FACE_MIN_CLUSTER = 2;
const FACE_INPUT_SIZE  = 320;
const FACE_DECODE_PX   = 640;
const FACE_MIN_FACE_PX = 48;
